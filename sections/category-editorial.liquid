{%- comment -%}
  Category collection editorial — the shared "Shop by Category" page body that
  renders below the product grid. Every string comes from section settings or
  blocks, so one section serves every category template (women's, unisex, kids,
  luxury, arabic, attar, perfume oils, inspired, miracle plant).

  Blocks:
    card — the four feature / scent-family cards
    faq  — one accordion row, also mirrored into FAQPage schema
{%- endcomment -%}

{%- comment -%}
  The default collection template is shared by many collections, so copy meant for
  one path must not leak onto the rest. When limit_to_path is set and the request
  is elsewhere, this section renders nothing.
{%- endcomment -%}
{%- if section.settings.limit_to_path != blank and request.path != section.settings.limit_to_path -%}
  {%- assign card_blocks = '' | split: ',' -%}
  {%- assign faq_blocks = '' | split: ',' -%}
  {%- assign sibling_blocks = '' | split: ',' -%}
  {%- assign explore_blocks = '' | split: ',' -%}
  {%- assign editorial_muted = true -%}
{%- else -%}
{%- assign card_blocks = section.blocks | where: 'type', 'card' -%}
{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- assign sibling_blocks = section.blocks | where: 'type', 'sibling' -%}
{%- assign explore_blocks = section.blocks | where: 'type', 'explore' -%}
{%- endif -%}

<!-- FEATURE / SCENT-FAMILY CARDS -->
{%- if card_blocks.size > 0 -%}
  <section class="section family-section"><div class="container">
    <div class="sec-head center">
      {%- if section.settings.cards_eyebrow != blank -%}<span class="label">{{ section.settings.cards_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.cards_heading != blank -%}<h2 class="sec-title">{{ section.settings.cards_heading }}</h2>{%- endif -%}
      {%- if section.settings.cards_sub != blank -%}<p class="sec-sub">{{ section.settings.cards_sub }}</p>{%- endif -%}
    </div>

    <div class="usp-grid four">
      {%- for block in card_blocks -%}
        {%- capture card_number -%}{{ forloop.index | prepend: '0' | slice: -2, 2 }}{%- endcapture -%}
        {%- capture card_inner -%}
          {%- if section.settings.show_numbers -%}<div class="fam-num">{{ card_number }}</div>{%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
          {%- if block.settings.tags != blank -%}
            <div class="fam-bestfor">
              <span class="bl">{{ block.settings.tag_label | default: 'Best For' }}</span>
              <div class="fam-tags">
                {%- assign tags = block.settings.tags | split: ',' -%}
                {%- for tag in tags -%}<span>{{ tag | strip }}</span>{%- endfor -%}
              </div>
            </div>
          {%- endif -%}
          {%- if block.settings.link_url != blank and block.settings.link_label != blank -%}
            <span class="fam-link">{{ block.settings.link_label }} <span class="mi" aria-hidden="true">arrow_forward</span></span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if block.settings.link_url != blank -%}
          <a class="usp-card fam-card fade-up" href="{{ block.settings.link_url }}" {{ block.shopify_attributes }}>{{ card_inner }}</a>
        {%- else -%}
          <div class="usp-card fam-card fade-up" {{ block.shopify_attributes }}>{{ card_inner }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cards_footnote != blank -%}
      <p class="sec-sub cards-footnote">{{ section.settings.cards_footnote }}</p>
    {%- endif -%}
  </div></section>
{%- endif -%}

<!-- SIBLING COLLECTIONS (lifestyle pages) -->
{%- if sibling_blocks.size > 0 -%}
  <section class="section"><div class="container">
    <div class="sec-head center">
      {%- if section.settings.sibling_eyebrow != blank -%}<span class="label">{{ section.settings.sibling_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.sibling_heading != blank -%}<h2 class="sec-title">{{ section.settings.sibling_heading }}</h2>{%- endif -%}
      {%- if section.settings.sibling_sub != blank -%}<p class="sec-sub">{{ section.settings.sibling_sub }}</p>{%- endif -%}
    </div>
    {%- comment -%}
      Image cards where the link resolves to a collection we can read, and the
      plain link row otherwise, so a card never silently disappears.
    {%- endcomment -%}
    <div class="hub-grid{% if sibling_blocks.size >= 4 %} four{% endif %}">
      {%- for block in sibling_blocks -%}
        {%- liquid
          assign sibling_handle = block.settings.url | split: '/collections/' | last | split: '?' | first | split: '#' | first
          assign sibling_collection = collections[sibling_handle]
        -%}
        {%- if sibling_collection.handle != blank -%}
          <div {{ block.shopify_attributes }}>
            {% render 'collection-card', collection: sibling_collection, label: block.settings.label %}
          </div>
        {%- else -%}
          <a class="crosslink" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label }}</span>
            <span class="mi" aria-hidden="true">arrow_forward</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.sibling_all_url != blank and section.settings.sibling_all_label != blank -%}
      <div class="sibling-all">
        <a class="btn-ghost" href="{{ section.settings.sibling_all_url }}">{{ section.settings.sibling_all_label }} <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
    {%- endif -%}
  </div></section>
{%- endif -%}

<!-- EXPLORE MORE COLLECTIONS -->
{%- if explore_blocks.size > 0 -%}
  <section class="section alt"><div class="container">
    <div class="sec-head center">
      <span class="label">{{ section.settings.explore_eyebrow | default: 'Keep Looking' }}</span>
      <h2 class="sec-title">{{ section.settings.explore_heading | default: 'Explore More <em>Collections</em>' }}</h2>
      {%- if section.settings.explore_sub != blank -%}<p class="sec-sub">{{ section.settings.explore_sub }}</p>{%- endif -%}
    </div>
    {%- comment -%}
      Tiles are skipped when they point at the hub this page already belongs to
      (a category page never offers "Shop by Category"), so the spare slot goes
      to whichever tile comes next — normally Shop by Brand.
    {%- endcomment -%}
    <div class="explore-grid">
      {%- assign tiles_shown = 0 -%}
      {%- for block in explore_blocks -%}
        {%- if tiles_shown >= 4 -%}{%- break -%}{%- endif -%}
        {%- if block.settings.hub != blank and block.settings.hub == section.settings.current_hub -%}
          {%- continue -%}
        {%- endif -%}
        <a class="explore-card fade-up" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
          <span class="mi ex-ic" aria-hidden="true">{{ block.settings.icon | default: 'grid_view' }}</span>
          <b>{{ block.settings.label }}</b>
          <span class="ex-sub">{{ block.settings.sub }}</span>
          <span class="ex-go">Browse <span class="mi" aria-hidden="true">arrow_forward</span></span>
        </a>
        {%- assign tiles_shown = tiles_shown | plus: 1 -%}
      {%- endfor -%}
    </div>
    {%- comment -%}
      The hub pages close this block with a see-all link; collection pages had
      the tiles and nothing after them. Defaulted in Liquid rather than through
      the schema because a `url` setting cannot carry a default — left unset it
      renders href="", so relying on the setting alone would have meant the link
      stayed missing across all 90 collection templates until each was edited.
    {%- endcomment -%}
    {%- assign explore_all_label = section.settings.explore_all_label | default: 'See All Categories' -%}
    {%- assign explore_all_url = section.settings.explore_all_url | default: '/collections' -%}
    {%- if explore_all_label != blank and explore_all_url != blank -%}
      <div class="sibling-all">
        <a class="btn-ghost" href="{{ explore_all_url }}">{{ explore_all_label }} <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
    {%- endif -%}
  </div></section>
{%- endif -%}

<!-- REVIEWS -->
{%- if section.settings.show_reviews and editorial_muted != true -%}
  {%- comment -%}
    Real reviews, or no reviews section at all. Judge.me holds this store's
    actual reviews; what used to fill this block was six invented customers
    written into app.js. With none synced the whole section — heading
    included — is absent, rather than a promise of testimonials over a gap.
  {%- endcomment -%}
  {%- if shop.metafields.judgeme.shop_reviews_count > 0 -%}
  <section class="reviews"><div class="reviews-inner">
    <div class="reviews-head fade-up">
      <span class="label">What Customers Say</span>
      <h2 class="sec-title">Loved by <em>Fragrance Lovers</em></h2>
    </div>
    {% render 'shop-reviews', show: 'summary' %}
    {% render 'shop-reviews', show: 'carousel' %}
  </div></section>
  {%- endif -%}
{%- endif -%}

<!-- FAQ -->
{%- if faq_blocks.size > 0 -%}
  <section class="faq"><div class="faq-inner">
    <div class="faq-head fade-up">
      <span class="label">Your Questions, Answered</span>
      <h2 class="sec-title">Frequently Asked <em>Questions</em></h2>
    </div>
    <div class="faq-list fade-up">
      {%- for block in faq_blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-q">{{ block.settings.question }}<span class="mi" aria-hidden="true">add</span></summary>
          <div class="faq-a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div></section>
{%- endif -%}

{%- comment -%} ── Structured data: BreadcrumbList + CollectionPage/ItemList + FAQPage ── {%- endcomment -%}
{%- liquid
  assign coll_url = shop.url | append: collection.url
  assign crumb_name = section.settings.crumb_name | default: collection.title
  # Comments inside a liquid tag must be '#' lines, and must not contain tag
  # delimiters, or Liquid tries to parse them and rejects the whole file.
  # The middle crumb names the page's real parent hub — Brands for a brand page,
  # Lifestyle for a lifestyle page — matching both the source documents and the
  # visible breadcrumb the hero renders. It was hardcoded to Perfumes /
  # collections/all, so the structured data contradicted the breadcrumb on screen.
  assign crumb_parent_label = section.settings.crumb_parent_label | default: 'Perfumes'
  assign crumb_parent_path = section.settings.crumb_parent_url | default: '/collections/all'
  assign crumb_parent_url = shop.url | append: crumb_parent_path
  assign schema_name = section.settings.schema_name | default: collection.title
  # When the copy is confined to another path the schema must describe this
  # collection, not the one the settings were written for.
  if editorial_muted
    assign crumb_name = collection.title
    assign crumb_parent_label = 'Perfumes'
    assign crumb_parent_url = shop.url | append: '/collections/all'
    assign schema_name = collection.title
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": {{ coll_url | append: '#breadcrumb' | json }},
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ crumb_parent_label | json }}, "item": {{ crumb_parent_url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ crumb_name | json }}, "item": {{ coll_url | json }} }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ coll_url | append: '#collectionpage' | json }},
  "url": {{ coll_url | json }},
  "name": {{ schema_name | json }},
  {%- if section.settings.schema_description != blank -%}
  "description": {{ section.settings.schema_description | json }},
  {%- endif -%}
  "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
  "breadcrumb": { "@id": {{ coll_url | append: '#breadcrumb' | json }} },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ shop.url | append: product.url | json }},
        "name": {{ product.title | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>

{%- if faq_blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faq_blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Category editorial",
  "settings": [
    { "type": "header", "content": "Feature cards" },
    { "type": "text", "id": "cards_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "cards_heading", "label": "Heading (H2)", "info": "Wrap words in <em></em> for the gold italic accent." },
    { "type": "textarea", "id": "cards_sub", "label": "Intro paragraph" },
    { "type": "textarea", "id": "cards_footnote", "label": "Closing paragraph" },
    { "type": "checkbox", "id": "show_numbers", "label": "Number the cards (01, 02, …)", "default": true },
    { "type": "header", "content": "Sibling collections", "info": "Shown only when Sibling link blocks are added." },
    { "type": "text", "id": "sibling_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "sibling_heading", "label": "Heading (H2)" },
    { "type": "textarea", "id": "sibling_sub", "label": "Intro paragraph" },
    { "type": "text", "id": "sibling_all_label", "label": "See-all link label" },
    { "type": "url", "id": "sibling_all_url", "label": "See-all link" },
    { "type": "header", "content": "Explore more" },
    { "type": "text", "id": "explore_eyebrow", "label": "Eyebrow", "default": "Keep Looking" },
    { "type": "text", "id": "explore_heading", "label": "Heading (H2)", "default": "Explore More <em>Collections</em>" },
    { "type": "text", "id": "explore_all_label", "label": "See-all link label", "info": "Defaults to \"See All Categories\" when left blank." },
    { "type": "url", "id": "explore_all_url", "label": "See-all link", "info": "Defaults to /collections when left blank." },
    { "type": "textarea", "id": "explore_sub", "label": "Intro paragraph" },
    {
      "type": "select", "id": "current_hub", "label": "This page's hub", "default": "none",
      "info": "The matching tile is hidden, so the page never links to the hub it already sits in.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "category", "label": "Shop by Category" },
        { "value": "lifestyle", "label": "Shop by Lifestyle" },
        { "value": "climate", "label": "Shop by Climate" },
        { "value": "brand", "label": "Shop by Brand" },
        { "value": "scent", "label": "Shop by Scent Family" }
      ]
    },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show the reviews band", "default": true },
    { "type": "header", "content": "Structured data" },
    { "type": "text", "id": "limit_to_path", "label": "Only render on this path", "info": "For the default collection template, which many collections share. e.g. /collections/all — the section renders nothing elsewhere. Leave blank to always render." },
    { "type": "text", "id": "crumb_name", "label": "Breadcrumb name", "info": "Leave blank to use the collection title." },
    { "type": "text", "id": "crumb_parent_label", "label": "Breadcrumb parent name", "info": "The hub this page sits under, e.g. Brands. Must match the visible breadcrumb in the hero. Defaults to Perfumes." },
    { "type": "text", "id": "crumb_parent_url", "label": "Breadcrumb parent path", "info": "e.g. /pages/brands. Defaults to /collections/all." },
    { "type": "text", "id": "schema_name", "label": "CollectionPage name", "info": "Usually the primary keyword, e.g. Women's Perfumes UAE." },
    { "type": "textarea", "id": "schema_description", "label": "CollectionPage description" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "tag_label", "label": "Tag label", "default": "Best For" },
        { "type": "text", "id": "tags", "label": "Tags", "info": "Comma separated." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    },
    {
      "type": "sibling",
      "name": "Sibling link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "explore",
      "name": "Explore tile",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "grid_view",
          "options": [
            { "value": "grid_view", "label": "Grid (category)" },
            { "value": "auto_awesome", "label": "Sparkle (lifestyle)" },
            { "value": "wb_sunny", "label": "Sun (climate)" },
            { "value": "spa", "label": "Petal (scent family)" },
            { "value": "storefront", "label": "Storefront (brand)" },
            { "value": "redeem", "label": "Gift" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "sub", "label": "Sub-label" },
        { "type": "url", "id": "url", "label": "Link" },
        {
          "type": "select", "id": "hub", "label": "Hub", "default": "none",
          "info": "Hidden when it matches this page's hub.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "category", "label": "Shop by Category" },
            { "value": "lifestyle", "label": "Shop by Lifestyle" },
            { "value": "climate", "label": "Shop by Climate" },
            { "value": "brand", "label": "Shop by Brand" },
            { "value": "scent", "label": "Shop by Scent Family" }
          ]
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [ { "name": "Category editorial" } ]
}
{% endschema %}
