{%- comment -%}
  The image-only banner, as a section for anywhere a section can go. The
  markup lives in snippets/image-banner.liquid because the offer page needs
  the same thing directly below its hero, and the hero, intro and grid are one
  section that template order cannot split.
{%- endcomment -%}

{% render 'image-banner',
   ib_image: section.settings.image,
   ib_image_sm: section.settings.image_sm,
   ib_alt: section.settings.alt,
   ib_link: section.settings.link,
   ib_full_bleed: section.settings.full_bleed,
   ib_starts_at: section.settings.starts_at,
   ib_ends_at: section.settings.ends_at %}

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "text", "id": "image", "label": "Image (theme asset filename)" },
    { "type": "text", "id": "image_sm", "label": "Phone image (theme asset filename)",
      "info": "Optional. A crop of the part that carries the message, so a wide banner stays readable." },
    { "type": "textarea", "id": "alt", "label": "Alt text",
      "info": "The words shown in the artwork. This is the only place they exist for a screen reader or for search." },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "checkbox", "id": "full_bleed", "label": "Full width", "default": false },
    { "type": "header", "content": "Live window" },
    { "type": "text", "id": "starts_at", "label": "Starts",
      "info": "ISO with offset, e.g. 2026-12-01T00:00:00+04:00. Blank = always." },
    { "type": "text", "id": "ends_at", "label": "Ends",
      "info": "Exclusive. 2026-12-06T00:00:00+04:00 removes it at UAE midnight." }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
