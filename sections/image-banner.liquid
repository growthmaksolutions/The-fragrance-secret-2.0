{%- comment -%}
  A banner that is only an image.

  For artwork whose message is set into it — this one says "Happy 55th Eid Al
  Etihad", "Sale is on live", "Up to 50% off" — rather than a background with
  theme text over it, which is what the hero does. Nothing is overlaid here.

  Because the words are part of the picture, the alt text is where they exist
  for a screen reader, for search, and for anyone whose connection drops the
  image. It is a required-in-practice setting, not decoration: left blank the
  banner is announced as nothing at all.

  A phone image is served separately when one is named. A 3:1 banner on a
  handset puts its headline a few pixels tall, so the mobile file is normally
  a crop of the half that carries the message.

  Carries its own start and end like the rest of the campaign, so it appears
  and goes without anyone editing the page.
{%- endcomment -%}

{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign in_window = true
  if section.settings.starts_at != blank
    assign start_ts = section.settings.starts_at | date: '%s' | plus: 0
    if now_ts < start_ts
      assign in_window = false
    endif
  endif
  if section.settings.ends_at != blank
    assign end_ts = section.settings.ends_at | date: '%s' | plus: 0
    if now_ts >= end_ts
      assign in_window = false
    endif
  endif
-%}

{%- if section.settings.image != blank and in_window -%}
  <section class="section-sm img-banner-sec{% if section.settings.full_bleed %} is-bleed{% endif %}">
    <div class="{% unless section.settings.full_bleed %}container{% endunless %}">
      {%- capture banner_img -%}
        <img class="img-banner"
             src="{{ section.settings.image | asset_url }}"
             {%- if section.settings.image_sm != blank %}
             srcset="{{ section.settings.image_sm | asset_url }} 1100w,
                     {{ section.settings.image | asset_url }} 2172w"
             sizes="100vw"
             {%- endif %}
             alt="{{ section.settings.alt | escape }}"
             loading="lazy" decoding="async">
      {%- endcapture -%}

      {%- if section.settings.link != blank -%}
        <a class="img-banner-link" href="{{ section.settings.link }}">{{ banner_img }}</a>
      {%- else -%}
        {{ banner_img }}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "text", "id": "image", "label": "Image (theme asset filename)" },
    { "type": "text", "id": "image_sm", "label": "Phone image (theme asset filename)",
      "info": "Optional. A crop of the part that carries the message, so a wide banner stays readable." },
    { "type": "textarea", "id": "alt", "label": "Alt text",
      "info": "The words shown in the artwork. This is the only place they exist for a screen reader or for search." },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "checkbox", "id": "full_bleed", "label": "Full width", "default": false },
    { "type": "header", "content": "Live window" },
    { "type": "text", "id": "starts_at", "label": "Starts",
      "info": "ISO with offset, e.g. 2026-12-01T00:00:00+04:00. Blank = always." },
    { "type": "text", "id": "ends_at", "label": "Ends",
      "info": "Exclusive. 2026-12-06T00:00:00+04:00 removes it at UAE midnight." }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
