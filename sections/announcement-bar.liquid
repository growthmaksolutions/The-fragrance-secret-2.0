{%- comment -%}
  Scrolling announcement marquee — ported from app.js announceHTML().

  The messages are merchant-editable blocks, so the free-delivery figure below
  is a literal: schema is static JSON and a Liquid tag inside it would be shown
  to shoppers verbatim. It is the one place the Delivery setting cannot reach —
  and only a default at that, since the live text lives in header-group.json
  once the section has been saved.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announce">
    <div class="announce-track" id="atrack">
      {%- comment -%} duplicated once so the CSS marquee loops seamlessly {%- endcomment -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <div class="a-item" {{ block.shopify_attributes }}>{{ block.settings.text }}<span class="dot">&#10022;</span></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [
      { "type": "message", "settings": { "text": "Complimentary delivery anywhere in the UAE on orders above AED 300" } },
      { "type": "message", "settings": { "text": "Every fragrance is 100% authentic with fully verified sourcing" } },
      { "type": "message", "settings": { "text": "Cash on delivery available across all Emirates for easy shopping" } },
      { "type": "message", "settings": { "text": "Explore 218+ fragrance houses trusted by perfume lovers in the UAE" } },
      { "type": "message", "settings": { "text": "Need assistance? Connect with our WhatsApp team daily from 10am to 7pm" } }
    ] }
  ]
}
{% endschema %}
