{%- comment -%}
  Scrolling announcement marquee — ported from app.js announceHTML().

  The messages are merchant-editable blocks, so the free-delivery figure below
  is a literal: schema is static JSON and a Liquid tag inside it would be shown
  to shoppers verbatim. It is the one place the Delivery setting cannot reach —
  and only a default at that, since the live text lives in header-group.json
  once the section has been saved.
{%- endcomment -%}
{%- comment -%}
  A message may carry its own start and end, for campaign lines that must
  appear and vanish on a date — the National Day offer runs to midnight on
  6 December and the bar is meant to stop advertising it then. Dates are
  compared as Unix epochs, which are timezone-independent, so a date written
  with the UAE offset switches at UAE midnight wherever the shopper is. Both
  blank, which is the case for the standing messages, means always on.
{%- endcomment -%}
{%- assign now_ts = 'now' | date: '%s' | plus: 0 -%}

{%- if section.blocks.size > 0 -%}
  <div class="announce">
    <div class="announce-track" id="atrack">
      {%- comment -%} duplicated once so the CSS marquee loops seamlessly {%- endcomment -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign show = true
            if block.settings.starts_at != blank
              assign start_ts = block.settings.starts_at | date: '%s' | plus: 0
              if now_ts < start_ts
                assign show = false
              endif
            endif
            if block.settings.ends_at != blank
              assign end_ts = block.settings.ends_at | date: '%s' | plus: 0
              if now_ts >= end_ts
                assign show = false
              endif
            endif
          -%}
          {%- if show and block.settings.text != blank -%}
            <div class="a-item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="a-link" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
              <span class="dot">&#10022;</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%}
    The marquee slides the track by exactly -50%, so the two halves above are
    what make it loop without a seam. That only looks continuous while one
    half is at least as wide as the screen: with a short set of messages the
    first half scrolls clear of a wide monitor before the second arrives, and
    the bar runs empty for a moment every lap.

    Doubling the whole track keeps the two halves identical, so the -50% stays
    correct however many times it runs. Capped, and it does nothing when the
    content is already wide enough, which is the usual case.
  {%- endcomment -%}
  <script>
    (function () {
      function fill() {
        var track = document.getElementById('atrack');
        if (!track || !track.parentElement) return;
        var need = track.parentElement.clientWidth * 2;
        for (var i = 0; i < 3 && track.scrollWidth < need; i++) {
          track.innerHTML += track.innerHTML;
        }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fill);
      else fill();
      addEventListener('resize', fill);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link (optional)" },
      { "type": "header", "content": "Live window (optional)" },
      { "type": "text", "id": "starts_at", "label": "Starts",
        "info": "ISO with offset, e.g. 2026-12-01T00:00:00+04:00. Blank = always on." },
      { "type": "text", "id": "ends_at", "label": "Ends",
        "info": "Exclusive. 2026-12-06T00:00:00+04:00 means the message is gone at midnight." }
    ] }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [
      { "type": "message", "settings": { "text": "Complimentary delivery anywhere in the UAE on orders above AED 300" } },
      { "type": "message", "settings": { "text": "Every fragrance is 100% authentic with fully verified sourcing" } },
      { "type": "message", "settings": { "text": "Cash on delivery available across all Emirates for easy shopping" } },
      { "type": "message", "settings": { "text": "Explore 218+ fragrance houses trusted by perfume lovers in the UAE" } },
      { "type": "message", "settings": { "text": "Need assistance? Connect with our WhatsApp team daily from 10am to 7pm" } }
    ] }
  ]
}
{% endschema %}
