{%- comment -%}
  Site header + Shop mega-menu — ported from app.js headerHTML()/navItemHTML().
  Internal links now point at native Shopify routes (/collections, /pages, /blogs).
  All interactivity (mobile drawer, scroll state) is handled by app.js.
{%- endcomment -%}

{%- liquid
  assign header_theme = section.settings.theme | default: 'dark'
  assign cart_count = cart.item_count | default: 0

  # Which top-level nav item the current page belongs to. The .nav-active
  # underline has always existed in the stylesheet, but the only thing that
  # ever set it was navItemHTML() in app.js — the demo renderer this section
  # replaced — so on the live site nothing was ever marked current.
  #
  # Brand and category pages are collections, so they light up Shop. The Brands
  # hub itself is a page and is matched by handle below.
  assign nav_active = ''
  case request.page_type
    when 'collection'
      assign nav_active = 'shop'
      # Perfume Oil has its own top-level entry, so it claims the underline on
      # its own page instead of leaving Shop marked current.
      if collection.handle == 'perfume-oil'
        assign nav_active = 'oil'
      endif
    when 'product'
      assign nav_active = 'shop'
    when 'list-collections'
      assign nav_active = 'shop'
    when 'blog'
      assign nav_active = 'guides'
    when 'article'
      assign nav_active = 'guides'
  endcase

  if request.page_type == 'page'
    assign shop_hub_pages = 'shop-by-lifestyle,shop-by-climate,shop-by-scent-family,crazy-deals,luxury-recommendations,shop-by-category' | split: ','
    assign guide_pages = 'buying-guides,journal,scent-education,care-storage,seasonal-trends' | split: ','
    if page.handle == 'brands'
      assign nav_active = 'brands'
    elsif page.handle == 'about'
      assign nav_active = 'about'
    elsif shop_hub_pages contains page.handle
      assign nav_active = 'shop'
    elsif guide_pages contains page.handle
      assign nav_active = 'guides'
    endif
  endif
-%}

<header id="hdr" class="{{ header_theme }}">
  <div class="nav-wrap">
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }} — Home">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160">
      {%- else -%}
        <img src="{{ 'logo.webp' | asset_url }}"
             srcset="{{ 'logo-sm.webp' | asset_url }} 220w, {{ 'logo.webp' | asset_url }} 400w"
             sizes="88px" alt="{{ shop.name }}" width="400" height="154">
      {%- endif -%}
    </a>

    <button class="nav-burger" aria-label="Menu" onclick="toggleMobileNav()"><span class="mi" aria-hidden="true">menu</span></button>

    <nav class="nav-links" id="navLinks">
      {%- comment -%}
        Close button lives inside the drawer, not in the header. The burger
        turns into a cross when the menu opens, but the drawer is z-index 1200
        inside a sticky header that opens its own stacking context, so whether
        that cross is reachable depends on a lift rule landing on the right
        Shopify section wrapper. A control inside the panel cannot be covered
        by the panel. Hidden above 1024px, where there is no drawer.
      {%- endcomment -%}
      <button type="button" class="nav-drawer-close" aria-label="Close menu" onclick="closeMobileNav()">
        <span class="mi" aria-hidden="true">close</span>
      </button>

      {%- comment -%} Shop — with mega-menu {%- endcomment -%}
      <div class="nav-item has-mega">
        <a href="/collections/all" class="nav-toplink{% if nav_active == 'shop' %} nav-active{% endif %}"{% if nav_active == 'shop' %} aria-current="page"{% endif %} onclick="toggleShopGroup(this, event)">Shop<span class="mi nav-caret" aria-hidden="true">expand_more</span></a>
        <div class="nav-mega"><div class="nav-mega-inner container">
          <div class="nm-col" onclick="toggleNavGroup(this, event)"><h5><a href="/collections/all">Shop</a></h5>
            <a href="/collections/all">All Products</a>
            <a href="/collections/best-sellers">Best Sellers</a>
            <a href="/collections/new-arrivals">New Arrivals</a>
            <a href="/collections/crazy-deals">Crazy Deals</a>
          </div>
          <div class="nm-col" onclick="toggleNavGroup(this, event)"><h5><a href="/pages/shop-by-category">Shop by Category</a></h5>
            <a href="/collections/mens-perfumes">Men's Perfumes</a>
            <a href="/collections/womens-perfumes">Women's Perfumes</a>
            <a href="/collections/kids-perfumes">Kids Perfumes</a>
            <a href="/collections/unisex-perfumes">Unisex Perfumes</a>
            <a href="/collections/luxury-perfumes">Luxury Perfumes</a>
            <a href="/collections/miracle-plant">Miracle Plant</a>
            <a href="/collections/perfume-oil">Perfume Oil</a>
            <a href="/collections/attar">Attar</a>
            <a href="/collections/arabic-perfumes">Arabic Perfumes</a>
            <a href="/collections/inspired-perfumes">Inspired Perfumes</a>
          </div>
          <div class="nm-col" onclick="toggleNavGroup(this, event)"><h5><a href="/pages/shop-by-lifestyle">Shop by Lifestyle</a></h5>
            <a href="/collections/everyday-perfumes">Everyday Perfumes</a>
            <a href="/collections/office-wear-perfumes">Office Wear Perfumes</a>
            <a href="/collections/date-night-perfumes">Date Night Perfumes</a>
            <a href="/collections/party-wear-perfumes">Party Wear Perfumes</a>
            <a href="/collections/wedding-perfumes">Wedding Perfumes</a>
            <a href="/collections/formal-event-perfumes">Formal Event Perfumes</a>
            <a href="/collections/gym-perfumes">Gym Perfumes</a>
            <a href="/collections/travel-perfumes">Travel Perfumes</a>
            <a href="/collections/beach-perfumes">Beach Perfumes</a>
            <a href="/collections/vacation-perfumes">Vacation Perfumes</a>
            <a href="/collections/evening-wear-perfumes">Evening Wear Perfumes</a>
          </div>
          <div class="nm-col" onclick="toggleNavGroup(this, event)"><h5><a href="/pages/shop-by-climate">Shop by Climate</a></h5>
            <a href="/collections/summer-wear-perfumes">Summer Wear Perfumes</a>
            <a href="/collections/winter-wear-perfumes">Winter Wear Perfumes</a>
            <a href="/collections/spring-wear-perfumes">Spring Wear Perfumes</a>
            <a href="/collections/rainy-day-perfumes">Rainy Day Perfumes</a>
            <a href="/collections/humid-weather-perfumes">Humid Weather Perfumes</a>
            <a href="/collections/tropical-climate-perfumes">Tropical Climate Perfumes</a>
            <a href="/collections/desert-climate-perfumes">Desert Climate Perfumes</a>
            <a href="/collections/hot-weather-perfumes">Hot Weather Perfumes</a>
            <a href="/collections/cold-weather-perfumes">Cold Weather Perfumes</a>
            <a href="/collections/dry-weather-perfumes">Dry Weather Perfumes</a>
          </div>
          <div class="nm-col" onclick="toggleNavGroup(this, event)"><h5><a href="/pages/shop-by-scent-family">By Scent Family</a></h5>
            <a href="/collections/oud-woody-perfumes">Oud &amp; Woody</a>
            <a href="/collections/fresh-citrus-perfumes">Fresh &amp; Citrus</a>
            <a href="/collections/floral-rose-perfumes">Floral &amp; Rose</a>
            <a href="/collections/sweet-gourmand-perfumes">Sweet &amp; Gourmand</a>
            <a href="/collections/spicy-oriental-perfumes">Spicy &amp; Oriental</a>
          </div>
        </div></div>
      </div>

      <a href="/pages/brands" class="nav-toplink{% if nav_active == 'brands' %} nav-active{% endif %}"{% if nav_active == 'brands' %} aria-current="page"{% endif %}>Brands</a>
      {%- comment -%}
        The Guides link is hidden from the nav. The guide pages and the journal
        blog still exist and are still reachable by URL and from search — only
        the top-level entry point is gone. The nav_active = 'guides' branches
        above are left in place so restoring this link is a one-line change.
      {%- endcomment -%}
      <a href="/pages/about" class="nav-toplink{% if nav_active == 'about' %} nav-active{% endif %}"{% if nav_active == 'about' %} aria-current="page"{% endif %}>About Us</a>

      <a href="#" class="nav-toplink nav-quiz" onclick="openAI();closeMobileNav();return false"><span class="mi" aria-hidden="true">auto_awesome</span>Find My Scent</a>
      {%- comment -%}
        Perfume Oil is in the Shop mega-menu as well, under Shop by Category.
        It is repeated at the top level because it is a category people come
        looking for by name rather than browse into — one tap from anywhere,
        instead of opening Shop and reading a list of ten. It sits after Find
        My Scent, so the browsing entries run first and the two shortcuts sit
        together at the end.
      {%- endcomment -%}
      <a href="/collections/perfume-oil" class="nav-toplink{% if nav_active == 'oil' %} nav-active{% endif %}"{% if nav_active == 'oil' %} aria-current="page"{% endif %}>Perfume Oil</a>
      {%- comment -%}
        Same treatment as the icon: opens the panel rather than loading the
        search page. Tapping it closes the drawer first, since the panel it
        opens sits behind it.
      {%- endcomment -%}
      <a href="{{ routes.search_url }}" class="nav-toplink nav-drawer-extra" data-search-toggle><span class="mi" aria-hidden="true">search</span>Search</a>
      <a href="{{ routes.account_url }}" class="nav-toplink nav-drawer-extra"><span class="mi" aria-hidden="true">person</span>Account</a>
      <a href="/pages/wishlist" class="nav-toplink nav-drawer-extra"><span class="mi" aria-hidden="true">favorite</span>Wishlist</a>
    </nav>

    <div class="nav-actions">
      {%- comment -%}
        Still an anchor to /search, not a button: without JS it has to go
        somewhere, and the search page is where. app.js intercepts the click
        and opens the panel below instead, so the trip only happens for a
        real search — on Enter, or on a suggestion.
      {%- endcomment -%}
      <a class="ni" href="{{ routes.search_url }}" title="Search" data-search-toggle
         aria-expanded="false" aria-controls="hdrSearch"><span class="mi" aria-hidden="true">search</span></a>
      <a class="ni" href="{{ routes.account_url }}" title="Account"><span class="mi" aria-hidden="true">person</span></a>
      {%- comment -%}
        The wishlist count lives in localStorage, so it cannot be rendered
        server-side. The badge starts hidden and wishlist.js fills it in —
        better than painting a "0" that flickers to a real number on load.
      {%- endcomment -%}
      <a class="ni" href="/pages/wishlist" title="Wishlist">
        <span class="mi" aria-hidden="true">favorite</span>
        <span class="wbadge" hidden>0</span>
      </a>
      <a class="ni" href="{{ routes.cart_url }}" title="Cart">
        <span class="mi" aria-hidden="true">shopping_bag</span>
        <span class="cbadge">{{ cart_count }}</span>
        {%- comment -%}
          The badge is a bare number with no label, so this link announced
          itself as "Cart, 3" — a digit with nothing to say what it counts.
          This names it. Not a live region: it is the link's accessible name,
          and announcing changes is the separate job below.
        {%- endcomment -%}
        <span class="visually-hidden" data-cart-announce>{{ cart_count }} item{% unless cart_count == 1 %}s{% endunless %} in bag</span>
      </a>
      {%- comment -%}
        Adding to the bag changed the badge from 3 to 4 and announced nothing,
        because a silent text swap is not an event — so for a screen-reader
        user the only confirmation an add had worked was the toast, which is
        not in a live region either.

        Deliberately empty at render and outside the link. Empty, because a
        live region with content in it at page load is announced on arrival,
        which would make every page open with "3 items in bag". Outside,
        because a region nested in a link is read as part of that link by
        some screen readers and re-announced whenever the badge repaints.
        app.js writes to it only on a real change.
      {%- endcomment -%}
      <span class="visually-hidden" role="status" aria-live="polite" data-cart-live></span>
    </div>
  </div>
  {%- comment -%}
    The search panel. Inside <header> so it travels with the sticky bar, and
    after .nav-wrap so it drops below the icon row rather than displacing it.

    The form is a plain GET to the search page: typing and pressing Enter
    works with no JavaScript at all, which is the whole reason it is a form
    and not a div. app.js adds the suggestions and the keyboard handling on
    top of that.
  {%- endcomment -%}
  <div class="hdr-search" id="hdrSearch" hidden>
    <form class="hdr-search-form" action="{{ routes.search_url }}" method="get" role="search"
          data-predictive-search>
      <input type="hidden" name="type" value="product">
      <span class="mi hdr-search-ic" aria-hidden="true">search</span>
      <input class="hdr-search-input" type="search" name="q" autocomplete="off"
             placeholder="Search perfumes, brands, notes…"
             aria-label="Search fragrances"
             role="combobox" aria-expanded="false" aria-controls="hdrSearchResults"
             aria-autocomplete="list" data-search-input>
      <button type="button" class="hdr-search-close" aria-label="Close search" data-search-close>
        <span class="mi" aria-hidden="true">close</span>
      </button>
    </form>
    <div class="hdr-search-panel" id="hdrSearchResults" data-search-results></div>
    <span class="visually-hidden" role="status" aria-live="polite" data-search-status></span>
  </div>

  {%- comment -%}
    The backdrop sits inside <header>, not after it, and that placement is the
    whole fix. The header is sticky at z-index 1000, which opens a stacking
    context, so the drawer's z-index 1200 only ever competed *inside* it. As a
    sibling of the header the overlay at 1150 therefore painted straight over
    the open drawer — dimming it and swallowing every tap, including on the
    close button.

    Inside the header the two are siblings in one context, so 1200 beats 1150
    honestly and no z-index lift on the section wrapper is needed. position:
    fixed still resolves against the viewport, since nothing here is
    transformed.
  {%- endcomment -%}
  <div class="nav-overlay" id="navOverlay" onclick="toggleMobileNav()" aria-hidden="true"></div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "select", "id": "theme", "label": "Header theme", "options": [
      { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }
    ], "default": "dark" }
  ]
}
{% endschema %}
