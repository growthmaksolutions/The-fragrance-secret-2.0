{%- comment -%}
  Collection page — native Shopify port of collection.html + collections.js.
  Uses collection.filters (configured in Search & Discovery) and
  collection.products with pagination + sort. Reproduces the .shop-layout /
  .shop-filters / .shop-results markup so the existing CSS applies unchanged.
{%- endcomment -%}

{%- liquid
  assign hero_image = collection.image | default: collection.metafields.custom.hero_image.value
  assign paginate_by = section.settings.products_per_page | default: 24

  # /collections/all is a built-in route with no collection to attach a template
  # to, so its copy lives in the default collection template. That template is
  # shared by 34 other collections, which must not inherit it. limit_to_path
  # confines the copy to one path; elsewhere the section falls back to the
  # collection's own title, exactly as before.
  assign copy_applies = true
  if section.settings.limit_to_path != blank and request.path != section.settings.limit_to_path
    assign copy_applies = false
  endif

  if copy_applies
    assign hero_eyebrow = section.settings.hero_eyebrow | default: 'The Collection'
    assign hero_heading = section.settings.hero_heading | default: collection.title
    assign hero_image_alt = section.settings.hero_image_alt | default: collection.title
    assign crumb_parent_label = section.settings.crumb_parent_label | default: 'Shop'
    assign crumb_parent_url = section.settings.crumb_parent_url | default: '/collections/all'
    assign hero_bg = section.settings.hero_bg_image
    assign hero_bg_sm = section.settings.hero_bg_image_sm
  else
    assign hero_eyebrow = 'The Collection'
    assign hero_heading = collection.title
    assign hero_image_alt = collection.title
    assign crumb_parent_label = 'Shop'
    assign crumb_parent_url = '/collections/all'
    assign hero_bg = ''
    assign hero_bg_sm = ''
  endif

  assign show_intro = false
  if copy_applies
    if section.settings.intro_heading != blank
      assign show_intro = true
    endif
    if section.settings.intro_text != blank
      assign show_intro = true
    endif
  endif

  # The intro heading carries the primary keyword, "Kids Perfumes UAE" where the
  # hero says only "Kids Perfumes", so it takes the H1 and the hero steps down to
  # H2. That keeps one H1 per page. Where a collection has no intro heading, or
  # the copy belongs to another path, the hero keeps the H1 so no page is left
  # without one. Styling is by class, so nothing changes visually.
  assign hero_tag = 'h1'
  assign intro_tag = 'h2'
  if show_intro and section.settings.intro_heading != blank
    assign hero_tag = 'h2'
    assign intro_tag = 'h1'
  endif
-%}

<div data-collection-native>

  <!-- PAGE HERO -->
  {%- capture collection_breadcrumb -%}
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <a href="{{ crumb_parent_url }}">{{ crumb_parent_label }}</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>{{ hero_heading | strip_html }}</span>
    </div>
  {%- endcapture -%}

  {%- capture hero_facts -%}
    <div class="ph-meta">
      <span><span class="mi" aria-hidden="true">verified_user</span>100% Authentic</span>
      <span><span class="mi" aria-hidden="true">local_shipping</span>Fast Shipping</span>
      <span><span class="mi" aria-hidden="true">lock</span>Secure Checkout</span>
    </div>
  {%- endcapture -%}

  {%- comment -%}
    An explicitly configured banner wins over the collection's own image.
    hero_image is collection.image, and the brand collections were given their
    logo as that image so the brand chips could show it — which silently flipped
    every brand page from its full-bleed banner to this split layout with the
    logo blown up in the figure. A banner named in the template is a deliberate
    choice about that page's hero; collection.image is not.
  {%- endcomment -%}
  {%- if hero_image and hero_bg == blank -%}
    <section class="page-hero split tall">
      <div class="container">
        <div>
          {{ collection_breadcrumb }}
          <span class="ph-eyebrow">{{ hero_eyebrow }}</span>
          <{{ hero_tag }} class="ph-title">{{ hero_heading }}</{{ hero_tag }}>
          {%- if collection.description != blank and section.settings.show_hero_description -%}<p class="ph-sub">{{ collection.description }}</p>{%- endif -%}
          {{ hero_facts }}
        </div>
        <figure class="ph-figure"><img src="{{ hero_image | image_url: width: 1200 }}" alt="{{ hero_image_alt | escape }}"></figure>
      </div>
    </section>
  {%- else -%}
    <section class="page-hero tall{% if hero_bg != blank %} has-bg{% endif %}">
      {%- if hero_bg != blank -%}
        <div class="ph-bg" aria-hidden="true">
          {%- comment -%}
            Full-bleed banner. A narrower variant is served to phones when one is
            named, so a handset does not download the 2880px desktop file.
          {%- endcomment -%}
          <img src="{{ hero_bg | asset_url }}"
               {%- if hero_bg_sm != blank %}
               srcset="{{ hero_bg_sm | asset_url }} 1200w,
                       {{ hero_bg | asset_url }} 2880w"
               sizes="100vw"
               {%- endif %}
               alt="" width="2880" height="1000" loading="eager" fetchpriority="high" decoding="async">
        </div>
      {%- endif -%}
      <div class="container">
        {{ collection_breadcrumb }}
        <span class="ph-eyebrow">{{ hero_eyebrow }}</span>
        <{{ hero_tag }} class="ph-title">{{ hero_heading }}</{{ hero_tag }}>
        {%- if collection.description != blank and section.settings.show_hero_description -%}<p class="ph-sub">{{ collection.description }}</p>{%- endif -%}
        {{ hero_facts }}
      </div>
    </section>
  {%- endif -%}

  <!-- TRUST BAND -->
  {%- if section.settings.show_trust_band -%}
    <section class="section-sm alt"><div class="container">
      <div class="trust-band">
        <div class="tb-item"><span class="mi" aria-hidden="true">verified_user</span><div><strong>100% Authentic</strong><span>Verified sourcing</span></div></div>
        <div class="tb-item"><span class="mi" aria-hidden="true">local_shipping</span><div><strong>Free UAE Delivery</strong><span>On orders above AED {{ settings.free_shipping_threshold | default: '250' }}</span></div></div>
        <div class="tb-item"><span class="mi" aria-hidden="true">payments</span><div><strong>Cash on Delivery</strong><span>Available UAE-wide</span></div></div>
        <div class="tb-item"><span class="mi" aria-hidden="true">autorenew</span><div><strong>{{ settings.returns_window_days | default: '2' }}-Day Returns</strong><span>Faulty or wrong items</span></div></div>
      </div>
    </div></section>
  {%- endif -%}

  <!-- COLLECTION INTRODUCTION -->
  {%- if show_intro -%}
    <section class="section-sm coll-intro"><div class="container coll-intro-grid{% if section.settings.intro_image != blank %} has-figure{% endif %}">
      <div class="coll-intro-copy">
        {%- if section.settings.intro_eyebrow != blank -%}<span class="label">{{ section.settings.intro_eyebrow }}</span>{%- endif -%}
        {%- if section.settings.intro_heading != blank -%}<{{ intro_tag }} class="sec-title">{{ section.settings.intro_heading }}</{{ intro_tag }}>{%- endif -%}
        {%- if section.settings.intro_text != blank -%}<div class="sec-sub coll-intro-body">{{ section.settings.intro_text }}</div>{%- endif -%}
      </div>

      {%- if section.settings.intro_image != blank -%}
        <figure class="coll-intro-figure">
          <img src="{{ section.settings.intro_image | asset_url }}"
               alt="{{ section.settings.intro_image_alt | escape }}"
               width="1536" height="1024" loading="lazy" decoding="async">
        </figure>
      {%- elsif section.settings.show_why_rotator -%}
        {% render 'why-choose-rotator', uid: section.id %}
      {%- endif -%}
    </div></section>

  {%- endif -%}

  {%- paginate collection.products by paginate_by -%}
  <section class="section" id="grid"><div class="container">
    <div class="results-head">
      <div><span class="label">The Collection</span><h2 class="sec-title results-title">Shop the Range</h2></div>
      <div class="results-count">{{ collection.products_count }} products</div>
    </div>

    {%- comment -%}
      Filters & Sort sits after the heading, not before it. It used to precede
      the whole grid section, so on phones the first thing under the intro was a
      control bar rather than the name of what you were looking at. It is a
      mobile-only control — .fb-toggle is display:none above 900px — so on
      desktop this only removes an empty sticky strip.
    {%- endcomment -%}
    <div class="filter-bar" id="filterBar"><div class="fb-inner">
      <button type="button" class="fb-toggle" id="fbToggle" onclick="document.getElementById('shopFilters').classList.add('open');document.getElementById('sfOverlay').classList.add('open')"><span class="mi" aria-hidden="true">tune</span>Filters &amp; Sort</button>
    </div></div>

    <div class="shop-layout">
      <aside class="shop-filters" id="shopFilters" aria-label="Product filters">
        <form>
          <div class="sf-head">
            <span class="sf-title"><span class="mi" aria-hidden="true">tune</span>Filters</span>
            <a class="sf-clear" href="{{ collection.url }}">Clear all</a>
            <button type="button" class="sf-close" id="sfClose" aria-label="Close filters" onclick="document.getElementById('shopFilters').classList.remove('open');document.getElementById('sfOverlay').classList.remove('open')"><span class="mi" aria-hidden="true">close</span></button>
          </div>
          <div class="sf-scroll">
            <div class="sf-group sf-sortgroup">
              <div class="sf-gtitle sf-gtitle-static">Sort By</div>
              <div class="sf-gbody">
                <select class="sf-sort" name="sort_by">
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}"{% if option.value == collection.sort_by or option.value == collection.default_sort_by %} selected{% endif %}>{{ option.name }}</option>
                  {%- endfor -%}
                </select>
              </div>
            </div>

            {%- for filter in collection.filters -%}
              <details class="sf-group" open {{ filter.shopify_attributes }}>
                <summary class="sf-gtitle">{{ filter.label }}<span class="mi sf-chev" aria-hidden="true">expand_more</span></summary>
                <div class="sf-gbody">
                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      <div class="sf-opts">
                        {%- for value in filter.values -%}
                          <label class="sf-opt">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}>
                            <span class="sf-box"><span class="mi" aria-hidden="true">check</span></span>
                            <span class="sf-label">{{ value.label }}</span>
                            <span class="sf-count">{{ value.count }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- when 'price_range' -%}
                      {%- comment -%}
                        Liquid returns min_value/max_value in cents but the query
                        parameter expects major units, so divide for display.
                      {%- endcomment -%}
                      {%- liquid
                        assign price_ceiling = filter.range_max | divided_by: 100.0 | ceil
                        assign price_from = ''
                        assign price_to = ''
                        if filter.min_value.value != nil
                          assign price_from = filter.min_value.value | divided_by: 100.0
                        endif
                        if filter.max_value.value != nil
                          assign price_to = filter.max_value.value | divided_by: 100.0
                        endif
                      -%}
                      <div class="sf-price">
                        <label class="sf-price-field">
                          <span class="sf-price-cur">{{ cart.currency.symbol }}</span>
                          <input type="number" name="{{ filter.min_value.param_name }}" value="{{ price_from }}"
                                 placeholder="0" min="0" max="{{ price_ceiling }}" step="any" inputmode="decimal"
                                 aria-label="Minimum price">
                        </label>
                        <span class="sf-price-sep">to</span>
                        <label class="sf-price-field">
                          <span class="sf-price-cur">{{ cart.currency.symbol }}</span>
                          <input type="number" name="{{ filter.max_value.param_name }}" value="{{ price_to }}"
                                 placeholder="{{ price_ceiling }}" min="0" max="{{ price_ceiling }}" step="any" inputmode="decimal"
                                 aria-label="Maximum price">
                        </label>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
            {%- comment -%} Without JS the form still works the old way {%- endcomment -%}
            <noscript><div class="sf-group"><div class="sf-gbody"><button type="submit" class="btn-g" style="width:100%;justify-content:center">Apply filters</button></div></div></noscript>
          </div>
        </form>
      </aside>

      <div class="shop-results">
        {%- comment -%}
          Applied filters, above the results. Rendered here rather than beside
          the heading so the Section Rendering swap of .shop-results keeps it
          in step with the grid it describes — and so it is read before the
          products rather than after them. It renders nothing when no filter
          is on.
        {%- endcomment -%}
        {% render 'filter-chips', collection: collection %}
        {%- if collection.products.size > 0 -%}
          {%- comment -%}
            "Oils last" reorders the page so concentrated oils and attars sit
            after the sprays. Shopify cannot do this itself: a smart collection
            can only sort alpha / price / created / best-selling, none of which
            groups by product type, and manual ordering is not available to
            rule-based collections.

            The grouping is therefore per page, which is why the collection's
            sort order matters alongside it — set alphabetically, this
            collection's first page holds no oils at all, and later pages show
            their sprays before their oils.
          {%- endcomment -%}
          {%- comment -%}
            Hersh deferral. The three Alezz Oud Hersh fragrances are the
            store's top sellers by a wide margin (95, 59 and 49 units), so
            under best-selling sort they opened almost every collection and
            every page started to look like the same collection. Rather than
            give up best-selling order on ~110 collections, any Hersh product
            that would land in the first two rows is held back and released
            right after the sixth other product — the start of row three on
            the three-column desktop grid, and lower still on smaller screens.
            Hersh products that already sit further down stay put, so nothing
            gets promoted by this.

            It only applies on page one with the collection's default sort. A
            shopper who picks price or A–Z gets exactly that order, and later
            pages are untouched so no gaps open up. Alezz Oud's own brand
            pages are exempt, because there Hersh is the point.

            Buckets are comma-delimited on both sides so one product id can
            never match as a substring of another.
          {%- endcomment -%}
          {%- liquid
            assign oils_last = section.settings.oils_last
            assign defer_hersh = false
            if section.settings.defer_hersh and paginate.current_page == 1
              if collection.sort_by == blank or collection.sort_by == collection.default_sort_by
                unless collection.handle contains 'alezz'
                  assign defer_hersh = true
                endunless
              endif
            endif
            assign lead_slots = 6
            assign lead_done = 0
            assign held = ','
            assign released = false
            assign oil_bucket = ','
          -%}
          <div class="products-grid" id="collGrid">
            {%- for product in collection.products -%}
              {%- liquid
                assign needle = ',' | append: product.id | append: ','
                assign ptitle = product.title | downcase
                assign ptype = product.type | downcase
                assign is_oil = false
                if oils_last
                  if ptype contains 'oil' or ptype contains 'attar'
                    assign is_oil = true
                  endif
                endif
                assign hold_it = false
                if defer_hersh and released == false and ptitle contains 'hersh'
                  assign hold_it = true
                endif
              -%}
              {%- if is_oil -%}
                {%- assign oil_bucket = oil_bucket | append: product.id | append: ',' -%}
              {%- elsif hold_it -%}
                {%- assign held = held | append: product.id | append: ',' -%}
              {%- else -%}
                {% render 'product-card', product: product %}
                {%- assign lead_done = lead_done | plus: 1 -%}
                {%- if defer_hersh and released == false and lead_done == lead_slots -%}
                  {%- for held_product in collection.products -%}
                    {%- assign held_needle = ',' | append: held_product.id | append: ',' -%}
                    {%- if held contains held_needle -%}
                      {% render 'product-card', product: held_product %}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign released = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} Fewer than six other products on the page: the held ones still render, last. {%- endcomment -%}
            {%- if defer_hersh and released == false and held != ',' -%}
              {%- for held_product in collection.products -%}
                {%- assign held_needle = ',' | append: held_product.id | append: ',' -%}
                {%- if held contains held_needle -%}
                  {% render 'product-card', product: held_product %}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if oils_last -%}
              {%- for product in collection.products -%}
                {%- assign needle = ',' | append: product.id | append: ',' -%}
                {%- if oil_bucket contains needle -%}
                  {% render 'product-card', product: product %}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <div class="pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page"><span class="mi" aria-hidden="true">chevron_left</span></a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>
                {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page"><span class="mi" aria-hidden="true">chevron_right</span></a>{%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {%- liquid
            assign filters_applied = false
            for filter in collection.filters
              if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
                assign filters_applied = true
              endif
            endfor
          -%}
          <div class="empty-state">
            <span class="mi es-ic" aria-hidden="true">search_off</span>
            {%- if filters_applied -%}
              <h3>No products match these filters</h3>
              <p>Try removing a filter, widening the price range, or clearing them all to see the full collection.</p>
              <a class="btn-g" href="{{ collection.url }}"><span class="mi" aria-hidden="true">restart_alt</span>Clear all filters</a>
            {%- else -%}
              <h3>No products yet</h3>
              <p>This collection is being curated. Explore all products in the meantime.</p>
              <a class="btn-g" href="/collections/all">Shop All Products</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div></section>
  <div class="sf-overlay" id="sfOverlay" onclick="document.getElementById('shopFilters').classList.remove('open');this.classList.remove('open')"></div>
  {%- endpaginate -%}

  <!-- REVIEWS -->
  {%- if section.settings.show_reviews -%}
    {%- comment -%}
      Real reviews, or no reviews section at all. Judge.me holds this store's
      actual reviews; what used to fill this block was six invented customers
      written into app.js. With none synced the whole section — heading
      included — is absent, rather than a promise of testimonials over a gap.
    {%- endcomment -%}
    {%- assign tfs_shop_reviews = shop.metafields.judgeme.shop_reviews_count | plus: 0 -%}
    {%- if tfs_shop_reviews > 0 -%}
    <section class="reviews"><div class="reviews-inner">
      <div class="reviews-head fade-up"><span class="label">What Customers Say</span><h2 class="sec-title">Loved by <em>Fragrance Lovers</em></h2></div>
      {% render 'shop-reviews', show: 'carousel' %}
    </div></section>
    {%- endif -%}
  {%- endif -%}

</div>

{%- comment -%}
  Filtering / sorting / pagination without a page reload. Uses the Section
  Rendering API to fetch this same section and swaps only the grid, the facet
  list and the product count. Falls back to a normal navigation on any error,
  and the form still submits the old way when JS is unavailable (noscript).
{%- endcomment -%}
<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};
    var BASE_URL = {{ collection.url | json }};
    var root = document.querySelector('[data-collection-native]');
    if (!root || !window.fetch || !window.DOMParser || !window.URLSearchParams) return;

    var busy = false;

    function buildUrl() {
      var form = root.querySelector('.shop-filters form');
      var params = new URLSearchParams();
      if (form) {
        new FormData(form).forEach(function (value, key) {
          if (String(value).trim() !== '') params.append(key, value);
        });
      }
      var query = params.toString();
      return BASE_URL + (query ? '?' + query : '');
    }

    function swap(doc, selector) {
      var next = doc.querySelector(selector);
      var current = document.querySelector(selector);
      if (next && current) current.parentNode.replaceChild(next, current);
    }

    /* Facets re-render too (counts and disabled states change), so carry the
       panel's scroll position and which groups are open across the swap. */
    function swapFilters(doc) {
      var next = doc.querySelector('.shop-filters');
      var current = document.querySelector('.shop-filters');
      if (!next || !current) return;
      var scroller = current.querySelector('.sf-scroll');
      var scrollTop = scroller ? scroller.scrollTop : 0;
      var open = [];
      current.querySelectorAll('details.sf-group').forEach(function (group) { open.push(group.open); });
      if (current.classList.contains('open')) next.classList.add('open');
      current.parentNode.replaceChild(next, current);
      next.querySelectorAll('details.sf-group').forEach(function (group, i) {
        if (typeof open[i] === 'boolean') group.open = open[i];
      });
      var nextScroller = next.querySelector('.sf-scroll');
      if (nextScroller) nextScroller.scrollTop = scrollTop;
    }

    function reveal() {
      if (typeof window.observeFadeUps === 'function') { window.observeFadeUps(); return; }
      document.querySelectorAll('.shop-results .fade-up').forEach(function (el) { el.classList.add('visible'); });
    }

    function render(url, push) {
      if (busy) return;
      busy = true;
      root.classList.add('is-filtering');
      var separator = url.indexOf('?') === -1 ? '?' : '&';
      fetch(url + separator + 'section_id=' + encodeURIComponent(SECTION_ID), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function (response) {
          if (!response.ok) throw new Error(response.status);
          return response.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          swap(doc, '.results-count');
          swapFilters(doc);
          swap(doc, '.shop-results');
          reveal();
          if (push) history.pushState({ url: url }, '', url);
          var grid = document.getElementById('grid');
          if (grid && grid.getBoundingClientRect().top < 0) {
            window.scrollTo({ top: grid.offsetTop - 84, behavior: 'smooth' });
          }
          busy = false;
          root.classList.remove('is-filtering');
        })
        .catch(function () { window.location.href = url; });
    }

    /* Price fields fire a change per keystroke-commit and per arrow click, so
       debounce them; checkboxes and the sort select apply immediately. */
    var priceTimer = null;
    root.addEventListener('change', function (event) {
      var field = event.target;
      if (!field.closest || !field.closest('.shop-filters form')) return;
      if (field.type === 'number') {
        clearTimeout(priceTimer);
        priceTimer = setTimeout(function () { render(buildUrl(), true); }, 600);
        return;
      }
      render(buildUrl(), true);
    });

    root.addEventListener('input', function (event) {
      if (event.target.type !== 'number') return;
      if (!event.target.closest('.shop-filters form')) return;
      clearTimeout(priceTimer);
      priceTimer = setTimeout(function () { render(buildUrl(), true); }, 600);
    });

    root.addEventListener('submit', function (event) {
      if (!event.target.closest('.shop-filters')) return;
      event.preventDefault();
      render(buildUrl(), true);
    });

    root.addEventListener('click', function (event) {
      var link = event.target.closest('a');
      if (!link || !link.getAttribute('href')) return;
      /* .fchip is a chip above the results removing one filter value. It
         carries Shopify's own url_to_remove, so it works as a plain link
         with no JavaScript — intercepting it here only buys the same
         in-place re-render the sidebar controls get, instead of a full
         page load for what is a smaller change than ticking a box. */
      if (link.classList.contains('sf-clear') || link.classList.contains('fchip') || link.closest('.pagination')) {
        event.preventDefault();
        render(link.getAttribute('href'), true);
      }
    });

    window.addEventListener('popstate', function () {
      render(location.pathname + location.search, false);
    });
  })();
</script>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "oils_last",
      "label": "Show perfume oils last",
      "default": false,
      "info": "Moves products whose type contains Oil or Attar to the end. Grouping is per page, so pair it with an alphabetical collection sort."
    },
    {
      "type": "checkbox",
      "id": "defer_hersh",
      "label": "Start Hersh fragrances from row 3",
      "default": true,
      "info": "The Alezz Oud Hersh fragrances are the top sellers, so under best-selling sort they open almost every collection. This keeps them out of the first two rows on page one. Ignored when a shopper picks another sort, and on Alezz Oud's own pages."
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Heading (H1)",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "text",
      "id": "hero_bg_image",
      "label": "Hero background image (theme asset filename)",
      "info": "e.g. mens-hero.webp — file must live in assets/. Used only when the collection has no image. Best at 2880 × 1000 with the left side dark."
    },
    {
      "type": "text",
      "id": "hero_bg_image_sm",
      "label": "Hero background image, small (theme asset filename)",
      "info": "Optional 1200 × 417 variant served to phones."
    },
    {
      "type": "text",
      "id": "limit_to_path",
      "label": "Only use this copy on this path",
      "info": "For the default collection template, which many collections share. e.g. /collections/all — every other collection then falls back to its own title. Leave blank to always apply."
    },
    {
      "type": "checkbox",
      "id": "show_hero_description",
      "label": "Show collection description in hero",
      "default": true
    },
    {
      "type": "text",
      "id": "crumb_parent_label",
      "label": "Breadcrumb parent label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "crumb_parent_url",
      "label": "Breadcrumb parent URL",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Sections"
    },
    {
      "type": "checkbox",
      "id": "show_trust_band",
      "label": "Show trust band under the hero",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews after the grid",
      "default": true,
      "info": "Turn off when a page section renders reviews further down."
    },
    {
      "type": "header",
      "content": "Collection introduction"
    },
    {
      "type": "text",
      "id": "intro_eyebrow",
      "label": "Intro eyebrow"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Intro heading (H2)",
      "info": "Carries the page's primary keyword. Leave blank to hide the intro."
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro copy"
    },
    {
      "type": "text",
      "id": "intro_image",
      "label": "Intro image (theme asset filename)",
      "info": "e.g. mens.png — file must live in assets/. Takes the place of the rotator."
    },
    {
      "type": "text",
      "id": "intro_image_alt",
      "label": "Intro image alt text"
    },
    {
      "type": "checkbox",
      "id": "show_why_rotator",
      "label": "Show 'Why choose us' rotator beside the intro",
      "default": false,
      "info": "Ignored when an intro image is set."
    }
  ],
  "presets": [
    {
      "name": "Collection page"
    }
  ]
}
{% endschema %}
