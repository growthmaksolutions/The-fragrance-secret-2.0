{%- comment -%} Cart — native Shopify port of cart.html, driven by the `cart` object. {%- endcomment -%}
{%- liquid
  # One number, in Theme settings › Delivery, instead of the 15000 that used
  # to be written into this file and the copy of it in the other cart
  # surface — and into sixteen sentences that quoted it in prose.
  assign free_ship_threshold = settings.free_shipping_threshold | default: 250 | times: 100
  assign remaining = free_ship_threshold | minus: cart.total_price
  if cart.total_price >= free_ship_threshold
    assign ship_pct = 100
  else
    assign ship_pct = cart.total_price | times: 100 | divided_by: free_ship_threshold
  endif
-%}

<div class="crumb-bar"><div class="container">
  <div class="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="mi" aria-hidden="true">chevron_right</span>
    <span>Cart</span>
  </div>
</div></div>

<section class="section"><div class="container">
  {%- if cart.item_count > 0 -%}
  <div class="sec-head">
    <span class="label">Your Bag</span>
    <h2 class="sec-title">Shopping <em>Cart</em></h2>
  </div>
  <form action="{{ routes.cart_url }}" method="post" id="cart-form">
    <div class="checkout-grid">
      <div class="co-block">
        <div id="cartLines">
          {%- for item in cart.items -%}
            <div class="co-line" data-price="{{ item.final_price }}" data-qty="{{ item.quantity }}" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              {%- if item.image -%}
                <a href="{{ item.url }}" class="cl-img"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80"></a>
              {%- endif -%}
              <div class="cl-body">
                <div class="cl-name"><a href="{{ item.url }}">{{ item.product.title }}</a></div>
                {%- comment -%}
                  Line-item properties, inside .cl-meta rather than beside it.
                  A Custom Mixed Spray line reads "100ml / Extrait" and nothing
                  else without them — the oil it is blended from is a property,
                  so unrendered means the shopper cannot check what they
                  ordered. They sit inside the meta div because .cl-body is
                  display:contents in the cart page's grid, so a sibling would
                  become an unplaced grid item and shove the quantity and price
                  rows around.

                  Shopify's convention: a key beginning _ is private to the
                  theme, and a blank value means the field went unfilled.
                {%- endcomment -%}
                <div class="cl-meta">{% unless item.variant.title == 'Default Title' %}{{ item.variant.title }}{% endunless %}{% if item.product.vendor %} · {{ item.product.vendor }}{% endif %}
                  {%- for prop in item.properties -%}
                    {%- unless prop.first == blank or prop.last == blank -%}
                      {%- if prop.first[0] != '_' -%}
                        <span class="cl-prop"><span>{{ prop.first }}</span> {{ prop.last }}</span>
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                </div>

                <div class="qty-wrap">
                  <button type="button" class="qty-btn" data-cart-step="-1" aria-label="Decrease quantity">&minus;</button>
                  <input class="qty-num" type="text" aria-label="Quantity for {{ item.product.title | escape }}" value="{{ item.quantity }}" readonly>
                  <button type="button" class="qty-btn" data-cart-step="1" aria-label="Increase quantity">+</button>
                </div>
              </div>
              <div class="cl-price" data-line-price>{{ item.final_line_price | money_with_currency }}</div>
              <button type="button" class="cart-remove" aria-label="Remove" data-cart-remove><span class="mi" aria-hidden="true">close</span></button>
            </div>
          {%- endfor -%}
        </div>

        <!-- CROSS-SELL -->
        <div class="upsell">
          <div class="upsell-head"><span class="mi" aria-hidden="true">auto_awesome</span>Complete your order</div>
          <div class="upsell-sub">Customers who bought these items also loved</div>
          {%- comment -%}
            Recommending something already in the bag is noise, so build a
            delimited id list and skip those. Delimiters matter: a bare
            "contains" would treat 123 as a match inside 1234.
          {%- endcomment -%}
          {%- capture cart_product_ids -%},{% for item in cart.items %}{{ item.product_id }},{% endfor %}{%- endcapture -%}
          {%- if collections['featured'].products.size > 0 -%}
            <div class="upsell-row products-grid">
              {%- assign shown = 0 -%}
              {%- for product in collections['featured'].products -%}
                {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
                {%- capture id_probe -%},{{ product.id }},{%- endcapture -%}
                {%- if cart_product_ids contains id_probe -%}{%- continue -%}{%- endif -%}
                {% render 'product-card', product: product %}
                {%- assign shown = shown | plus: 1 -%}
              {%- endfor -%}
            </div>
          {%- else -%}<div class="upsell-row products-grid" data-render="products" data-count="3"></div>{%- endif -%}
        </div>
      </div>

      <aside>
        <div class="co-summary">
          <div class="co-sum-head">Order Summary</div>
          <div class="ship-nudge" id="shipNudge">
            {%- if cart.total_price >= free_ship_threshold -%}
              <p id="shipMsg"><span class="mi" aria-hidden="true" style="vertical-align:-4px;color:var(--gold-dk)">local_shipping</span> <b>Free delivery unlocked</b> — you're over {{ free_ship_threshold | money_with_currency }} <span class="mi" aria-hidden="true" style="font-size:15px;vertical-align:-3px;color:var(--gold-dk)">check_circle</span></p>
            {%- else -%}
              <p id="shipMsg"><span class="mi" aria-hidden="true" style="vertical-align:-4px;color:var(--gold-dk)">local_shipping</span> You’re <b>{{ remaining | money_with_currency }}</b> away from <b>free delivery</b></p>
            {%- endif -%}
            <div class="ship-bar"><i id="shipBar" style="width:{{ ship_pct }}%"></i></div>
          </div>
          {% render 'welcome-offer', style: 'row' %}
          {%- comment -%}
            Collapsed by default — see the snippet for why an open, empty code
            box sends shoppers off the site looking for something to put in
            it. Above the totals, because that is where the discount it
            produces will appear.
          {%- endcomment -%}
          {% render 'cart-coupon', uid: 'page' %}
          {%- comment -%}
            Subtotal is the price before discounts and Total is what Shopify
            will charge, so the two only differ when something has actually
            come off — and when it has, #cartDiscounts names it. Both are kept
            in step by repaint() below after every quantity change.
          {%- endcomment -%}
          <div class="co-totals">
            <div class="co-trow"><span>Subtotal</span><span id="cartSub">{{ cart.original_total_price | money_with_currency }}</span></div>
            <div id="cartDiscounts">{% render 'cart-discounts', row_class: 'co-trow' %}</div>
            <div class="co-trow"><span>Delivery</span><span id="cartShip" style="color:var(--gold-dk)">{% if cart.total_price >= free_ship_threshold %}Free{% else %}Calculated at checkout{% endif %}</span></div>
            <div class="co-trow"><span>VAT (5%)</span><span>Included</span></div>
            <div class="co-trow grand"><span>Total</span><b id="cartTotal">{{ cart.total_price | money_with_currency }}</b></div>

            <div class="pay-badges" aria-label="Payment options" style="margin-top:16px">
              <span class="pay-badge">COD</span><span class="pay-badge">Tabby</span><span class="pay-badge">Tamara</span><span class="pay-badge">Apple Pay</span><span class="pay-badge">Cards</span>
            </div>

            <button type="submit" name="checkout" class="btn-g co-place" style="justify-content:center;margin-top:8px;width:100%"><span class="mi" aria-hidden="true">lock</span>Proceed to Checkout</button>
            <a class="btn-ghost" href="/collections/all" style="justify-content:center;margin-top:16px;display:flex"><span class="mi" aria-hidden="true">arrow_back</span>Continue shopping</a>
            {%- comment -%}
              This replaces a single centred line that read "100% authentic ·
              2-day returns on faults · Secure checkout". Every clause was
              true and not one of them was actionable: the returns terms were
              described rather than linked, there was no arrival date, and no
              way to ask a question. On Shopify Basic the checkout cannot
              carry any of that, so the cart is the last place it can go.
            {%- endcomment -%}
            {% render 'checkout-reassurance', uid: 'cart' %}
          </div>
        </div>
      </aside>
    </div>
  </form>
  {%- else -%}
    <div style="min-height:56vh;display:flex;align-items:center;justify-content:center">
      <div class="empty-state" style="max-width:560px;margin:0 auto;padding:40px 20px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
        <span class="mi" aria-hidden="true" style="font-size:56px;color:var(--gold)">shopping_bag</span>
        <h3 class="sec-title" style="margin:0">Your cart is empty</h3>
        <p class="sec-sub" style="margin:0">Discover 218+ authentic houses — your signature scent is waiting.</p>
        <div class="cta-actions" style="justify-content:center;flex-wrap:wrap;margin-top:6px">
          <a class="btn-g" href="/collections/best-sellers">Shop Best Sellers</a>
          <button class="btn-o" onclick="openAI()" style="color:var(--ink);border-color:rgba(13,10,6,.28)"><span class="mi" aria-hidden="true">auto_awesome</span>Find My Scent</button>
        </div>
      </div>
    </div>
  {%- endif -%}
</div></section>

<script>
(function () {
  var lines = document.getElementById('cartLines');
  if (!lines) return;

  var FREE_SHIP = {{ free_ship_threshold | json }};
  var busy = false;

  function esc(v) {
    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* Mirrors the Liquid above: same filtering, same markup, so a line looks
     identical before and after a quantity change re-renders it. */
  function propsHTML(item) {
    var props = item.properties || {};
    return Object.keys(props).filter(function (k) {
      return k && k[0] !== '_' && props[k] !== null && props[k] !== '';
    }).map(function (k) {
      return '<span class="cl-prop"><span>' + esc(k) + '</span> ' + esc(props[k]) + '</span>';
    }).join('');
  }

  function discRow(title, amount) {
    return '<div class="co-trow is-disc"><span><span class="mi" aria-hidden="true">sell</span>' +
      esc(title) + '</span><span>\u2212' + window.formatMoney(amount) + '</span></div>';
  }

  /* Mirrors the Liquid row above, for a product added from the cross-sell that
     this page has never rendered. */
  function rowHTML(item) {
    var meta = [];
    if (item.variant_title && item.variant_title !== 'Default Title') meta.push(esc(item.variant_title));
    if (item.vendor) meta.push(esc(item.vendor));
    return '<div class="co-line" data-price="' + item.final_price + '" data-qty="' + item.quantity +
             '" data-key="' + esc(item.key) + '">' +
        (item.image ? '<a href="' + esc(item.url) + '" class="cl-img"><img src="' + esc(item.image) +
             '" alt="' + esc(item.product_title) + '" width="80"></a>' : '') +
        '<div class="cl-body">' +
          '<div class="cl-name"><a href="' + esc(item.url) + '">' + esc(item.product_title) + '</a></div>' +
          '<div class="cl-meta">' + meta.join(' · ') + propsHTML(item) + '</div>' +
          '<div class="qty-wrap">' +
            '<button type="button" class="qty-btn" data-cart-step="-1" aria-label="Decrease quantity">&minus;</button>' +
            '<input class="qty-num" type="text" aria-label="Quantity for ' + esc(item.product_title) + '" value="' + item.quantity + '" readonly>' +
            '<button type="button" class="qty-btn" data-cart-step="1" aria-label="Increase quantity">+</button>' +
          '</div>' +
        '</div>' +
        '<div class="cl-price" data-line-price>' + window.formatMoney(item.final_line_price) + '</div>' +
        '<button type="button" class="cart-remove" aria-label="Remove" data-cart-remove><span class="mi" aria-hidden="true">close</span></button>' +
      '</div>';
  }

  /* Everything the summary needs is keyed by id, so the whole page never has to
     be re-fetched just to move a quantity by one. */
  function repaint(cart) {
    (cart.items || []).forEach(function (item) {
      var row = lines.querySelector('.co-line[data-key="' + item.key + '"]');
      if (!row) { lines.insertAdjacentHTML('beforeend', rowHTML(item)); return; }
      row.setAttribute('data-qty', item.quantity);
      row.setAttribute('data-price', item.final_price);
      var num = row.querySelector('.qty-num');
      if (num) num.value = item.quantity;
      var lp = row.querySelector('[data-line-price]');
      if (lp) lp.textContent = window.formatMoney(item.final_line_price);
    });

    /* Rows the cart no longer contains were removed — drop them. */
    var live = {};
    (cart.items || []).forEach(function (i) { live[i.key] = true; });
    [].slice.call(lines.querySelectorAll('.co-line')).forEach(function (row) {
      if (!live[row.getAttribute('data-key')]) row.remove();
    });

    var sub = document.getElementById('cartSub');
    var tot = document.getElementById('cartTotal');
    if (sub) sub.textContent = window.formatMoney(cart.original_total_price);
    if (tot) tot.textContent = window.formatMoney(cart.total_price);

    /* Mirrors snippets/cart-discounts.liquid. A percentage discount is
       re-allocated across the lines on every change, so the amount moves with
       the quantity — leaving the Liquid-rendered row in place would show the
       discount for a bag that no longer exists. */
    var discBox = document.getElementById('cartDiscounts');
    if (discBox) {
      var rows = '', named = 0;
      (cart.cart_level_discount_applications || []).forEach(function (d) {
        named += d.total_allocated_amount;
        rows += discRow(d.title, d.total_allocated_amount);
      });
      var rest = (cart.total_discount || 0) - named;
      if (rest > 0) rows += discRow('Item discounts', rest);
      discBox.innerHTML = rows;
    }

    var ship = document.getElementById('cartShip');
    if (ship) ship.textContent = cart.total_price >= FREE_SHIP ? 'Free' : 'Calculated at checkout';

    var bar = document.getElementById('shipBar');
    if (bar) bar.style.width = Math.min(100, Math.round(cart.total_price * 100 / FREE_SHIP)) + '%';
    var msg = document.getElementById('shipMsg');
    if (msg) {
      msg.innerHTML = cart.total_price >= FREE_SHIP
        ? '<span class="mi" aria-hidden="true" style="vertical-align:-4px;color:var(--gold-dk)">local_shipping</span> <b>Free delivery unlocked</b> \u2014 you\u2019re over ' + window.formatMoney(FREE_SHIP)
        : '<span class="mi" aria-hidden="true" style="vertical-align:-4px;color:var(--gold-dk)">local_shipping</span> You\u2019re <b>' + window.formatMoney(FREE_SHIP - cart.total_price) + '</b> away from <b>free delivery</b>';
    }

    document.querySelectorAll('.cbadge').forEach(function (b) { b.textContent = cart.item_count; });
    if (typeof cartCount !== 'undefined') cartCount = cart.item_count;

    /* A recommendation the shopper has just accepted is no longer a
       recommendation — drop any cross-sell card whose variant is now in the bag. */
    var inCart = {};
    (cart.items || []).forEach(function (i) { inCart[i.variant_id] = true; });
    document.querySelectorAll('.upsell-row .prod-card[data-variant]').forEach(function (card) {
      if (inCart[card.getAttribute('data-variant')]) card.remove();
    });
    var row = document.querySelector('.upsell-row');
    var upsell = document.querySelector('.upsell');
    if (upsell && row && !row.querySelector('.prod-card')) upsell.hidden = true;

    /* Emptying the bag has to change the page rather than leave an empty grid.
       Built here instead of reloading, which is the whole point of this. */
    if (cart.item_count === 0) {
      var form = document.getElementById('cart-form');
      var head = form && form.previousElementSibling;
      if (head && head.classList.contains('sec-head')) head.remove();
      if (form) {
        form.outerHTML =
          '<div style="min-height:56vh;display:flex;align-items:center;justify-content:center">' +
          '<div class="empty-state" style="max-width:560px;margin:0 auto;padding:40px 20px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">' +
          '<span class="mi" aria-hidden="true" style="font-size:56px;color:var(--gold)">shopping_bag</span>' +
          '<h3 class="sec-title" style="margin:0">Your cart is empty</h3>' +
          '<p class="sec-sub" style="margin:0">Discover 218+ authentic houses \u2014 your signature scent is waiting.</p>' +
          '<div class="cta-actions" style="justify-content:center;flex-wrap:wrap;margin-top:6px">' +
          '<a class="btn-g" href="/collections/best-sellers">Shop Best Sellers</a>' +
          '</div></div></div>';
      }
    }
  }

  function change(key, quantity, row) {
    if (busy) return;
    busy = true;
    if (row) row.style.opacity = '.5';
    fetch((window.routes && window.routes.cart_change_url) || '/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: quantity })
    }).then(function (r) { if (!r.ok) throw 0; return r.json(); })
      .then(function (cart) { repaint(cart); })
      .catch(function () { if (typeof toast === 'function') toast('Could not update cart'); })
      .then(function () { busy = false; if (row) row.style.opacity = ''; });
  }

  /* Quick Add in the cross-sell posts through addLiveToCart, which announces
     the fresh cart. Without this the bag changed server-side — including the
     quantity bump when the product was already in it — while the lines above
     kept showing the old state. */
  document.addEventListener('cart:updated', function (e) {
    if (e.detail) repaint(e.detail);
  });

  lines.addEventListener('click', function (e) {
    var step = e.target.closest('[data-cart-step]');
    var rm = e.target.closest('[data-cart-remove]');
    if (!step && !rm) return;
    var row = (step || rm).closest('.co-line');
    if (!row) return;
    var key = row.getAttribute('data-key');
    /* Read the quantity off the DOM rather than a value baked in at render
       time, so repeated clicks keep counting from where the cart actually is. */
    var current = parseInt(row.getAttribute('data-qty'), 10) || 0;
    change(key, rm ? 0 : Math.max(0, current + parseInt(step.getAttribute('data-cart-step'), 10)), row);
  });
})();
</script>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
