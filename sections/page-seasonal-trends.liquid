
    <!-- HERO -->
    <section class="page-hero tall">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <span class="mi" aria-hidden="true">chevron_right</span>
          <a href="/blogs/journal">Guides</a>
          <span class="mi" aria-hidden="true">chevron_right</span>
          <span>Seasonal Trends</span>
        </div>
        <span class="ph-eyebrow">Seasonal Fragrance Trends</span>
        <h1 class="ph-title">The Scents Defining <em>This Season</em></h1>
        <p class="ph-sub">Fragrance moves with the calendar. As the UAE summer peaks, we track the notes, families and bottles rising to the top — so your scent always feels intentional, current and perfectly matched to the weather.</p>
        <div class="ph-meta">
          <span><span class="mi" aria-hidden="true">wb_sunny</span>Summer 2026 edit</span>
          <span><span class="mi" aria-hidden="true">local_florist</span>Trending notes</span>
          <span><span class="mi" aria-hidden="true">shopping_bag</span>Curated picks</span>
        </div>
      </div>
    </section>

    <!-- CURRENT SEASON FEATURE -->
    <section class="section">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">In Season Now</span>
          <h2 class="sec-title">Summer 2026: Scents That <em>Beat the Heat</em></h2>
          <p class="sec-sub">When the mercury climbs past 40°C, heavy fragrance turns cloying. This is the season for luminous citrus, cooling aquatics and airy florals that stay crisp from morning to night.</p>
        </div>
        <div class="feature-article fade-up">
          <div class="fa-media"><img src="{{ 'hero-gold.png' | asset_url }}" alt="Fresh citrus perfume bottle in bright light" /></div>
          <div class="fa-body">
            <span class="bl-cat">The Summer Standout</span>
            <h2>Cool, Clean &amp; Effortless — The Fresh Citrus Revival</h2>
            <p>Bergamot, neroli, sea salt and vetiver are having a moment. Fragrances like Armaf Club de Nuit and Mancera Cedrat Boise deliver that just-showered brightness that reads elegant in the heat, without ever feeling sharp. Lightweight EDTs and skin-close attars let you re-apply through the day without overwhelming a room.</p>
            <a class="btn-ghost" href="/collections/fresh-citrus-perfumes">Shop fresh &amp; citrus <span class="mi" aria-hidden="true">arrow_forward</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- SEASONAL TREND CARDS -->
    <section class="section alt">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Trends by Season</span>
          <h2 class="sec-title">A Scent for Every <em>Time of Year</em></h2>
          <p class="sec-sub">Three signature moods to plan your rotation around — tap any card to shop the family.</p>
        </div>
        <div class="topic-grid fade-up">
          <a class="topic-card" href="/collections/fresh-citrus-perfumes">
            <span class="mi" aria-hidden="true">wb_sunny</span>
            <h3>Citrus for Summer</h3>
            <p>In season now. Bergamot, lemon, neroli and marine notes stay bright and breathable through the Gulf heat.</p>
            <span class="btn-ghost topic-go">Shop the family <span class="mi" aria-hidden="true">arrow_forward</span></span>
          </a>
          <a class="topic-card" href="/collections/floral-rose-perfumes">
            <span class="mi" aria-hidden="true">local_florist</span>
            <h3>Fresh Florals for Spring</h3>
            <p>Rose, jasmine and airy white florals — romantic, light and made for milder, breezy days.</p>
            <span class="btn-ghost topic-go">Shop the family <span class="mi" aria-hidden="true">arrow_forward</span></span>
          </a>
          <a class="topic-card" href="/collections/spicy-oriental-perfumes">
            <span class="mi" aria-hidden="true">local_fire_department</span>
            <h3>Warm Spices for Winter</h3>
            <p>Amber, saffron, oud and resins that bloom in cooler evenings and leave a rich, lasting trail.</p>
            <span class="btn-ghost topic-go">Shop the family <span class="mi" aria-hidden="true">arrow_forward</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- EDITORIAL SPOTLIGHT -->
    <section class="section">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Trend Spotlight</span>
          <h2 class="sec-title">The Rise of <em>Gourmand Ouds</em></h2>
          <p class="sec-sub">One trend refuses to fade — the marriage of dessert-sweet gourmand notes with deep, smoky oud.</p>
        </div>
        <div class="feature-article fade-up">
          <div class="fa-media"><img src="{{ 'hero-oud.jpg' | asset_url }}" alt="Deep amber oud fragrance bottle" /></div>
          <div class="fa-body">
            <span class="bl-cat">On the Rise</span>
            <h2>Coffee, Caramel &amp; Oud — A Modern UAE Signature</h2>
            <p>Lattafa Khamrah Qahwa and Al Haramain Amber Oud Gold captured something the region can't get enough of: the comfort of gourmand sweetness anchored by resinous, long-wearing oud. Worn lightly it's inviting; worn boldly it's unforgettable — a trend built for evenings, celebrations and cooler nights ahead.</p>
            <a class="btn-ghost" href="/collections/sweet-gourmand-perfumes">Explore gourmand picks <span class="mi" aria-hidden="true">arrow_forward</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- CURATED SEASON PICKS -->
    <section class="section alt">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Shop the Edit</span>
          <h2 class="sec-title">Curated Picks for <em>the Season</em></h2>
          <p class="sec-sub">Hand-selected bottles our team is reaching for right now — all 100% authentic, all ready to ship.</p>
        </div>
        {%- if collections['featured'].products.size > 0 -%}<div class="products-grid fade-up">{%- for product in collections['featured'].products limit: 8 -%}{% render 'product-card', product: product %}{%- endfor -%}</div>{%- else -%}<div class="products-grid fade-up" data-render="products" data-count="8"></div>{%- endif -%}
      </div>
    </section>

    <!-- CROSS-LINKS -->
    <section class="section">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Keep Exploring</span>
          <h2 class="sec-title">Where to Go <em>Next</em></h2>
          <p class="sec-sub">Pair these trends with a deeper dive — or jump straight to a scent family.</p>
        </div>
        <div class="crosslink-grid fade-up">
          <a class="crosslink" href="/pages/buying-guides"><span>Perfume Buying Guides</span><span class="mi" aria-hidden="true">arrow_forward</span></a>
          <a class="crosslink" href="/collections/fresh-citrus-perfumes"><span>Fresh &amp; Citrus</span><span class="mi" aria-hidden="true">arrow_forward</span></a>
          <a class="crosslink" href="/collections/floral-rose-perfumes"><span>Floral &amp; Rose</span><span class="mi" aria-hidden="true">arrow_forward</span></a>
          <a class="crosslink" href="/collections/oud-woody-perfumes"><span>Oud &amp; Woody</span><span class="mi" aria-hidden="true">arrow_forward</span></a>
          <a class="crosslink" href="/collections/spicy-oriental-perfumes"><span>Spicy &amp; Oriental</span><span class="mi" aria-hidden="true">arrow_forward</span></a>
          <a class="crosslink" href="/collections/sweet-gourmand-perfumes"><span>Sweet &amp; Gourmand</span><span class="mi" aria-hidden="true">arrow_forward</span></a>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    {%- comment -%}
      Real reviews, or no reviews section at all. Judge.me holds this store's
      actual reviews; what used to fill this block was six invented customers
      written into app.js. With none synced the whole section — heading
      included — is absent, rather than a promise of testimonials over a gap.
    {%- endcomment -%}
    {%- assign tfs_shop_reviews = shop.metafields.judgeme.all_reviews_count | plus: 0 -%}
    {%- if tfs_shop_reviews > 0 -%}
    <section class="section alt">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Verified Reviews</span>
          <h2 class="sec-title">Loved Across the <em>Emirates</em></h2>
          <p class="sec-sub">What customers say about shopping the season's trending scents with us.</p>
        </div>
        {% render 'shop-reviews', show: 'carousel' %}
      </div>
    </section>
    {%- endif -%}

    <!-- NEWSLETTER -->
    <section class="final-cta">
      <div class="fca-inner fade-up">
        <span class="label" style="color:var(--gold)">Stay in the Loop</span>
        <h2 class="sec-title" style="color:var(--white)">Never Miss a <em>Seasonal Edit</em></h2>
        <p class="sec-sub" style="margin:12px auto 0">Be first to see each season's trending notes and curated drops — straight to your inbox.</p>
        <div class="capture-form">
          <input type="email" placeholder="Your email address" aria-label="Email" />
          <button class="btn-g">Subscribe</button>
        </div>
      </div>
    </section>

{% schema %}
{ "name": "Seasonal trends page", "settings": [] }
{% endschema %}
