{%- comment -%}
  Global band above the footer. Uses the same membership band as the collection
  and hub pages, so there is one version of it across the site. What it offers,
  and whether it appears at all, is decided by the welcome-offer snippet.

  It can be suppressed per page. The National Day offer page needs this: the
  band advertises "AED 10 Off Your First Perfume Order", and WELCOME10 cannot
  be combined with offer prices, so leaving it there promises a discount that
  the checkout then refuses — the complaint arrives after the customer has
  already decided to buy.
{%- endcomment -%}

{%- liquid
  assign hide = false
  if section.settings.hide_on_paths != blank
    assign hide_paths = section.settings.hide_on_paths | split: ','
    for raw_path in hide_paths
      assign hide_path = raw_path | strip
      if hide_path != blank and request.path == hide_path
        assign hide = true
      endif
    endfor
  endif
-%}

{%- unless hide -%}
  {% render 'member-band' %}
{%- endunless -%}

{% schema %}
{
  "name": "Membership band",
  "settings": [
    { "type": "paragraph", "content": "Shows the welcome-discount band above the footer. It follows the offer: guests are asked to join, members who have not ordered get the button that puts the code on their bag, and it disappears once the discount has been used. The code, the percentage and the on/off switch live in Theme settings › Welcome offer; the copy lives in snippets/member-band.liquid so every page stays identical." },
    { "type": "textarea", "id": "hide_on_paths", "label": "Hide on these paths",
      "info": "Comma separated, exact paths, e.g. /collections/uae-national-day-offer. Use where the welcome code cannot be combined with the page's prices." }
  ],
  "presets": [ { "name": "Membership band" } ]
}
{% endschema %}
