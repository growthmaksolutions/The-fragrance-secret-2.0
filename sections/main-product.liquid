{%- comment -%}
  Product detail page — native Shopify port of product.html.
  Driven by the `product` object (gallery, variants, price, description,
  metafields) with fallbacks so a bare product still renders the design.
{%- endcomment -%}

{%- liquid
  assign p = product
  assign cv = product.selected_or_first_available_variant
  assign brand = product.vendor | default: 'The Fragrance Secrets'
  assign rating = product.metafields.reviews.rating.value.rating | default: product.metafields.custom.rating.value | default: 4.9
  assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.custom.review_count.value | default: 0
  assign longevity = product.metafields.custom.longevity.value | default: '8–12 hours'
  assign sillage = product.metafields.custom.sillage.value | default: 'Strong'
  assign best_for = product.metafields.custom.best_for.value | default: 'Evening / Party'
  assign origin = product.metafields.custom.origin.value | default: 'UAE'
  assign notes_top = product.metafields.custom.notes_top.value
  assign notes_heart = product.metafields.custom.notes_heart.value
  assign notes_base = product.metafields.custom.notes_base.value
  assign badge = product.metafields.custom.badge.value | default: 'Bestseller'
  assign mf = product.metafields.custom
  assign fragrance_experience = mf.fragrance_experience.value
  assign why_love = mf.why_youll_love.value
  assign best_for_details = mf.best_for_details.value
  assign faq = mf.faq.value

  comment
    Does THIS product ship free whatever the order is worth? Liquid cannot
    answer that on its own — there is no product.delivery_profile, and the
    product object says nothing about which rates apply to it. Product type
    is not a stand-in either: the free-shipping profile is entirely type
    Oil, but other Oil products sit in profiles with different rates.

    So the answer is carried as data. scripts/sync-free-shipping-metafield.py
    reads the real delivery profiles and stamps custom.free_shipping on the
    products whose profile delivers to the UAE at zero cost with no minimum.
    Re-run it after any change to Settings › Shipping and delivery.

    Unset reads as false, which is the safe direction: the page then quotes
    the threshold, which is the general rule and true of most of the
    catalogue.
  endcomment
  assign ships_free = false
  if product.metafields.custom.free_shipping.value == true
    assign ships_free = true
  endif

  comment
    "100% Authentic Perfumes" was written into the trust list for every
    product, which is wrong the moment the catalogue holds something that is
    not a perfume. On the JABR bakhoor it told a shopper the incense they
    were buying was an authentic perfume.

    Derived from the product's own type rather than set per product: the
    catalogue already records what each thing is, and a metafield would be a
    second place to say it that can disagree with the first. Anything
    unrecognised keeps "Perfumes", which is true of all but a handful.
  endcomment
  assign type_l = product.type | downcase
  assign authentic_noun = 'Perfumes'
  if type_l contains 'bakhoor' or type_l contains 'bukhoor' or type_l contains 'incense'
    assign authentic_noun = 'Bukhoor'
  elsif type_l contains 'attar'
    assign authentic_noun = 'Attars'
  elsif type_l contains 'oil'
    assign authentic_noun = 'Perfume Oils'
  endif
-%}

<main-product class="page active" id="product" data-product>
  <!-- BREADCRUMB HERO -->
  <div class="pdp-hero">
    <div class="pdp-hero-inner">
      <div class="breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="mi" aria-hidden="true">chevron_right</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span class="mi" aria-hidden="true">chevron_right</span>
        {%- endif -%}
        <span>{{ product.title }}</span>
      </div>
    </div>
  </div>

  {%- comment -%}
    The product form used to wrap this whole section. It now opens and closes
    around the CTA block alone, further down, and the reason is the
    back-in-stock form. Shopify's contact form is a real <form> element and
    nesting one inside another is invalid HTML — the browser drops the inner
    tags and the notify fields end up posting to /cart/add.

    (Written out in prose rather than as the tag itself: Liquid parses the
    contents of a comment block even though it does not execute them, so an
    unclosed block tag quoted in here is a parse error, not documentation.)

    Nothing else needed the wrapper. The only controls that have to be inside
    a product form are the hidden variant id, the quantity input, the submit
    button and the dynamic payment button, and all four live in .cta-block.
    The variant buttons are type="button" and resolve through app.js, which
    writes the chosen id into that hidden input.
  {%- endcomment -%}
    <section class="pdp-main">
      <div class="pdp-main-inner">

        <!-- GALLERY -->
        <div class="pdp-gallery">
          <div class="thumb-list" id="thumblist">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media limit: 6 -%}
                <div class="thumb{% if forloop.first %} active{% endif %}" data-full="{{ media | image_url: width: 900 }}"><img src="{{ media | image_url: width: 160 }}" alt="View {{ forloop.index }}"></div>
              {%- endfor -%}
            {%- else -%}
              <div class="thumb active" data-full="{{ 'prod-bouquet-oud.png' | asset_url }}"><img src="{{ 'prod-bouquet-oud.png' | asset_url }}" alt="View 1"></div>
              <div class="thumb" data-full="{{ 'hero-oud.jpg' | asset_url }}"><img src="{{ 'hero-oud.jpg' | asset_url }}" alt="View 2"></div>
              <div class="thumb" data-full="{{ 'prod-shaghaf.png' | asset_url }}"><img src="{{ 'prod-shaghaf.png' | asset_url }}" alt="View 3"></div>
            {%- endif -%}
          </div>
          <div class="main-img-wrap">
            {%- if product.featured_media -%}
              <img class="main-img" id="mainimg" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}">
            {%- else -%}
              <img class="main-img" id="mainimg" src="{{ 'prod-bouquet-oud.png' | asset_url }}" alt="{{ product.title | escape }}">
            {%- endif -%}
            {%- if badge != blank -%}<div class="img-badge">{{ badge }}</div>{%- endif -%}
            <div class="zoom-hint"><span class="mi" aria-hidden="true">zoom_in</span>Hover to zoom</div>
          </div>
        </div>

        <!-- INFO -->
        <div class="pdp-info">
          <div class="pdp-brand">{{ brand }}</div>
          <h1 class="pdp-title">{{ product.title }}</h1>
          {%- comment -%}
            Rating and review count, under the title. theme.css has carried
            rules for .pdp-rating-row .stars, .rv-count and .rv-link since the
            port without any markup ever rendering them — the slot held the
            Judge.me preview badge alone, which paints nothing until the app's
            script arrives and so left the title with nothing beneath it.

            Read from the standard `reviews` namespace, which Judge.me writes
            into: the same figures the widget below shows, but server-rendered,
            so they are there at first paint and hold their space instead of
            shifting the price row down when the app loads.

            Gated on reviews.rating_count for the reason the reviews section
            states further down — custom.review_count carries demo values on a
            handful of products. Note the `rating` assign at the top of this
            file defaults to 4.9: a display fallback, not evidence, and stars
            on a product nobody has reviewed are an invention. So the count
            decides, and nothing here is rendered without one.

            With no count the Judge.me badge keeps the slot: it still shows its
            own stars if the app holds reviews the metafields have not synced,
            and collapses to nothing when there are genuinely none — the
            "No reviews yet" prompt lives in the reviews section, once.
          {%- endcomment -%}
          {%- liquid
            assign rv_count = product.metafields.reviews.rating_count.value | plus: 0
            assign rv_rating = product.metafields.reviews.rating.value.rating
          -%}
          <div class="pdp-rating-row">
            {%- if rv_count > 0 and rv_rating != blank -%}
              {% render 'star-rating', rating: rv_rating %}
              {%- comment -%}
                Every star is aria-hidden, so the score has to be readable as
                text or a screen reader gets a rating row that says nothing.
              {%- endcomment -%}
              <span class="rv-count">{{ rv_rating | times: 1.0 | round: 1 }} out of 5</span>
              <a class="rv-link" href="#pdp-reviews">{{ rv_count }} review{% unless rv_count == 1 %}s{% endunless %}</a>
            {%- else -%}
              <!-- Judge.me preview badge -->
              <div style='clear:both'></div>
              <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-template='product'>{{ product.metafields.judgeme.badge }}</div>
            {%- endif -%}
          </div>
          <div class="pdp-price-row" data-price-row>
            <span class="pdp-price-now">{{ cv.price | money_with_currency }}</span>
            {%- if cv.compare_at_price > cv.price -%}
              <span class="pdp-price-was">{{ cv.compare_at_price | money_with_currency }}</span>
              <span class="pdp-price-save">Save {{ cv.compare_at_price | minus: cv.price | times: 100.0 | divided_by: cv.compare_at_price | round }}%</span>
            {%- endif -%}
          </div>

          {%- comment -%}
            VARIANT PICKER
            158 products carry a real second option — mostly the perfume oils'
            100g/250g/500g/1kg ladder — and without this the page could only
            ever sell `selected_or_first_available_variant`, which on those
            products is the 1kg. The catalogue spells the option name
            weight / size / Size / SIZE depending on when the product was
            imported, and two products carry a stray name (a vendor string and
            "SIZER"), so the label is normalised instead of printed raw.

            Values render as buttons and the variant list ships as JSON beside
            them; app.js resolves the chosen values to a variant and updates
            the price, stock line, add-to-cart and ?variant= in the URL. With
            no JS the buttons are inert but the form still posts the default
            variant, exactly as before.
          {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            <div class="variants-block" data-variant-picker>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign oname = option.name | downcase | strip
                  assign last_value = option.values | last | downcase
                  assign label = option.name
                  if oname == 'weight' or oname == 'size' or oname == 'sizer'
                    assign label = 'Size'
                  elsif last_value contains 'kg' or last_value contains 'ml' or last_value contains 'g'
                    assign label = 'Size'
                  endif
                -%}
                <div class="var-group" data-option-index="{{ forloop.index0 }}">
                  <div class="var-title" id="var-label-{{ forloop.index0 }}">{{ label }}</div>
                  <div class="var-options" role="radiogroup" aria-labelledby="var-label-{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      {%- if option.selected_value == value -%}{%- assign is_on = true -%}{%- else -%}{%- assign is_on = false -%}{%- endif -%}
                      <button type="button" class="var-btn{% if is_on %} active{% endif %}"
                              role="radio"
                              aria-checked="{{ is_on }}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-option-value="{{ value | escape }}">{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
              <script type="application/json" data-variant-data>
                [
                {%- for v in product.variants -%}
                  {
                    "id": {{ v.id }},
                    "options": {{ v.options | json }},
                    "available": {{ v.available }},
                    "price": {{ v.price | money_with_currency | json }},
                    "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money_with_currency | json }}{% else %}null{% endif %},
                    "save": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}{% else %}null{% endif %},
                    "img": {% if v.featured_media %}{{ v.featured_media | image_url: width: 900 | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
                ]
              </script>
            </div>
          {%- endunless -%}

          <!-- REASSURANCE -->
          <div class="urgency-block" style="background:rgba(201,168,76,.07);border-color:rgba(201,168,76,.22)">
            <div class="ub-stock" style="color:var(--gold-dk)"><span class="mi" aria-hidden="true">local_shipping</span>
              {%- if cv.available -%}In stock — ships within 48 hours{%- else -%}Currently out of stock{%- endif -%}
            </div>
            <div class="ub-sep" style="background:rgba(201,168,76,.3)"></div>
            <div class="ub-views"><span class="mi" aria-hidden="true">verified_user</span>Authenticity guaranteed · {{ settings.returns_window_days | default: '2' }}-day returns</div>
          </div>

          {%- comment -%}
            Delivery estimate, directly above Add to Cart. "Ships within 48
            hours" is a fact about the warehouse; this is the answer to the
            question the shopper is actually asking, and it is the one piece
            of information that stops a slow-delivery abandonment happening
            two steps later in checkout.

            Hidden on a variant that cannot be bought — there is no date to
            promise for something out of stock, and app.js toggles this row
            with the rest of the buy controls when a size is picked.
          {%- endcomment -%}
          <div class="pdp-delivery" data-delivery-row{% unless cv.available %} hidden{% endunless %}>
            {% render 'delivery-estimate', uid: 'pdp' %}
            {%- comment -%}
              "to the UAE" used to sit here. The destination picker now says
              where it is going, in the shopper's own words, so repeating the
              country beside it was saying the same thing twice and less
              precisely.
            {%- endcomment -%}
            {%- comment -%}
              The threshold is only the rule for products in a profile that
              charges under it. On a free-shipping product this line used to
              quote AED 250 anyway — understating the store's own offer, and
              telling someone buying one AED 110 bottle they were about to
              pay a delivery fee they would never be charged.
            {%- endcomment -%}
            {%- if ships_free -%}
              <span class="de-note">free delivery, any order value</span>
            {%- else -%}
              <span class="de-note">free over AED {{ settings.free_shipping_threshold | default: '250' }}</span>
            {%- endif -%}
          </div>

          <!-- CTA BLOCK (primary action — kept above the fold) -->
          {%- form 'product', product, id: 'product-form', class: 'pdp-form' -%}
          <input type="hidden" name="id" value="{{ cv.id }}">
          <div class="cta-block">
            <div class="qty-row">
              <div class="qty-wrap">
                <button type="button" class="qty-btn" onclick="changeQty(-1)">&minus;</button>
                <input class="qty-num" id="qtynum" name="quantity" type="text" value="1" readonly>
                <button type="button" class="qty-btn" onclick="changeQty(1)">+</button>
              </div>
              <button type="submit" name="add" class="atc-btn"{% unless cv.available %} disabled{% endunless %}><span class="mi" aria-hidden="true">shopping_bag</span>{% if cv.available %}Add to Cart{% else %}Sold Out{% endif %}</button>
              {%- comment -%}
                Same store as the card hearts, so saving here shows as saved on
                every collection page and vice versa.
              {%- endcomment -%}
              <button type="button" class="atc-wish pa-wish"
                      data-wish="{{ product.handle }}"
                      data-wish-label="{{ product.title | escape }}"
                      aria-pressed="false"
                      title="Save to wishlist"
                      aria-label="Save {{ product.title | escape }} to wishlist"
                      onclick="TFSWishlist.toggle(this.dataset.wish, this.dataset.wishLabel)"><span class="mi" aria-hidden="true">favorite</span></button>
            </div>
            {{ form | payment_button }}
            {% render 'pay-icons' %}
            <p class="pay-note">Pay later, interest-free in 4 with <span class="pay-chip pay-chip-inline pay-tabby" title="Tabby">tabby</span> &amp; <span class="pay-chip pay-chip-inline pay-tamara" title="Tamara">tamara</span> · <span class="pay-chip pay-chip-inline pay-cod" title="Cash on Delivery"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.4"/></svg>COD</span> available UAE-wide</p>
            {%- comment -%}
              Two conditions, not one. The first is which products can be a
              base. The second is whether there is anything to sell: the
              wizard quotes a price and adds a line, and both come from the
              Custom Mixed Spray product. Unpublish that product and this
              button stops being offered, rather than walking a shopper
              through three steps to a button that cannot work — which is
              what it did on 140 pages before the product existed at all.
            {%- endcomment -%}
            {%- assign mix_product = all_products['custom-mixed-spray'] -%}
            {%- assign is_mix_base = false -%}
            {%- if product.type contains 'Oil' or product.type contains 'Attar' or product.tags contains 'oil' or product.tags contains 'attar' -%}
              {%- assign is_mix_base = true -%}
            {%- endif -%}
            {%- if is_mix_base and mix_product.handle != blank and mix_product.available -%}
            <button type="button" class="mix-cta" onclick="openMix('{{ product.title | escape | replace: "'", "\\'" }}')">
              <span class="mi" aria-hidden="true">science</span>
              Mix It Into a Spray
              <span class="mix-tag">50 / 100ml</span>
            </button>
            {%- endif -%}
          </div>
          {%- endform -%}

          {%- comment -%}
            Back in stock — outside the product form, which is why that form
            was narrowed above. Hidden while the selected variant is sellable;
            app.js shows it and fills in the variant when a sold-out size is
            picked, so the page always offers something to do instead of a
            dead "Sold Out" button.
          {%- endcomment -%}
          {% render 'back-in-stock', product: product, variant: cv %}

          <!-- KEY INFO -->
          <div class="key-info">
            <div class="ki-item"><div class="ki-icon"><span class="mi" aria-hidden="true">schedule</span></div><div class="ki-label">Longevity</div><div class="ki-val">{{ longevity }}</div></div>
            <div class="ki-item"><div class="ki-icon"><span class="mi" aria-hidden="true">air</span></div><div class="ki-label">Projection</div><div class="ki-val">{{ sillage }}</div></div>
            <div class="ki-item"><div class="ki-icon"><span class="mi" aria-hidden="true">person</span></div><div class="ki-label">Best For</div><div class="ki-val">{{ best_for }}</div></div>
            <div class="ki-item"><div class="ki-icon"><span class="mi" aria-hidden="true">public</span></div><div class="ki-label">Made In</div><div class="ki-val">{{ origin }}</div></div>
            {%- comment -%}
              No "Inspired By" tile. It used to sit here with the other key
              facts, and it repeated what the product title now says outright
              — "Baccarat Rouge 540 Inspired Perfume Oil …" — in a worse form,
              because the metafield holds the supplier's spelling of the
              original ("Baccarat Rough Aj") rather than the real name.
            {%- endcomment -%}
          </div>
          {%- comment -%}
            The disclaimer stays. The claim did not go away with the tile, it
            moved up into the title, and a note like this has to travel with
            the claim rather than live only in the terms of service. The
            metafield is still the right test for which products make one.
          {%- endcomment -%}
          {%- if mf.inspired_by.value != blank -%}
          <p class="ki-inspired-note">An independent interpretation of this scent profile. Not produced by, affiliated with or endorsed by the original brand; the name is used only to describe the scent character.</p>
          {%- endif -%}

          <!-- FRAGRANCE FAMILY + NOTES -->
          {%- if mf.fragrance_family.value != blank -%}
          <div class="fragrance-family">
            <span class="ff-label">Fragrance Family</span>
            <span class="ff-val">{{ mf.fragrance_family.value | replace: ', ', ' • ' }}</span>
          </div>
          {%- endif -%}
          {%- if notes_top or notes_heart or notes_base -%}
          <div class="notes-block">
            <div class="notes-title">Fragrance Notes</div>
            <div class="notes-row">
              {%- if notes_top -%}<span class="note-tag"><strong>Top</strong>{{ notes_top }}</span>{%- endif -%}
              {%- if notes_heart -%}<span class="note-tag"><strong>Heart</strong>{{ notes_heart }}</span>{%- endif -%}
              {%- if notes_base -%}<span class="note-tag"><strong>Base</strong>{{ notes_base }}</span>{%- endif -%}
            </div>
          </div>
          {%- endif -%}


          {%- comment -%}
            Every figure here is a setting, not a number typed into the line:
            the delivery threshold, the welcome discount and its minimum are
            the same values the cart, the band and the checkout rate use. A
            trust list is the worst place for a stale promise, because it is
            read at the moment someone decides to buy.
          {%- endcomment -%}
          <!-- TRUST -->
          <div class="pdp-trust">
            <div class="pt-item"><span class="mi" aria-hidden="true">verified_user</span><span><strong>100% Authentic {{ authentic_noun }}</strong> — Sourced from trusted suppliers</span></div>
            {%- comment -%}
              Same correction as the delivery row above: the trust list was
              the other place quoting a threshold that does not apply to
              every product.
            {%- endcomment -%}
            {%- if ships_free -%}
              <div class="pt-item"><span class="mi" aria-hidden="true">local_shipping</span><span><strong>Free Delivery</strong> — On this product, whatever your order is worth</span></div>
            {%- else -%}
              <div class="pt-item"><span class="mi" aria-hidden="true">local_shipping</span><span><strong>Free Delivery</strong> — On orders above AED {{ settings.free_shipping_threshold | default: '250' }}</span></div>
            {%- endif -%}
            <div class="pt-item"><span class="mi" aria-hidden="true">autorenew</span><span><strong>Easy Returns</strong> — Eligible damaged or incorrect orders only</span></div>
            <div class="pt-item"><span class="mi" aria-hidden="true">lock</span><span><strong>Secure Payments</strong> — Visa, Mastercard, Apple Pay &amp; Cash on Delivery</span></div>
            {%- comment -%}
              The discount line is shown only while it is true: hidden when the
              offer is switched off, and hidden from a customer who has already
              ordered, since a first-order discount they cannot use is an
              irritation rather than a reason to buy.
            {%- endcomment -%}
            {%- liquid
              # Truthiness, not `customer == nil` — the same equality test read
              # false for a logged-out visitor when this was written into the
              # membership band, and showed them the signed-in control.
              assign wo_show = false
              if settings.welcome_offer_enabled and settings.welcome_offer_code != blank
                if customer
                  if customer.orders_count == 0
                    assign wo_show = true
                  endif
                else
                  assign wo_show = true
                endif
              endif
            -%}
            {%- if wo_show -%}
              <div class="pt-item"><span class="mi" aria-hidden="true">redeem</span><span><strong>Claim {{ settings.welcome_offer_percent | default: '10' }}% Discount</strong> — Get {{ settings.welcome_offer_percent | default: '10' }}% off your first order above AED {{ settings.welcome_offer_min | default: '150' }}</span></div>
            {%- endif -%}
          </div>

          <!-- TABS — one per detail section, driven by metafields -->
          <div class="pdp-tabs">
            <div class="tab-header">
              <button type="button" class="tab-btn active" onclick="switchTab(this,'desc')">Description</button>
              {%- if best_for_details != blank -%}<button type="button" class="tab-btn" onclick="switchTab(this,'bestfor')">Best For</button>{%- endif -%}
              <button type="button" class="tab-btn" onclick="switchTab(this,'specs')">Specifications</button>
              <button type="button" class="tab-btn" onclick="switchTab(this,'ship')">Shipping &amp; Returns</button>
            </div>
            <div class="tab-content">
              <!-- Description -->
              <div class="tab-pane active" id="desc">
                {%- if product.description != blank -%}{{ product.description }}
                {%- else -%}<p>Crafted for those who want to stand out, this fragrance blends deep, resonant notes with warmth and sharpness — a truly magnetic presence that commands attention from the first spray.</p>{%- endif -%}

                {%- comment -%}
                  "Why you'll love it" follows the description in the same tab.
                  Each line of the metafield is "Label: sentence", so the label
                  is pulled out and set in bold — split on the first colon only,
                  since the prose after it can contain one. A line with no colon
                  is printed whole rather than mangled.

                  Reuses .tab-pane h4 / ul, which the Best For tab already uses,
                  so this needs no styling of its own.
                {%- endcomment -%}
                {%- if why_love != blank -%}
                  <h4>Why You'll Love It</h4>
                  <ul>
                    {%- assign wyl_lines = why_love | strip | newline_to_br | split: '<br />' -%}
                    {%- for raw_line in wyl_lines -%}
                      {%- assign wyl = raw_line | strip -%}
                      {%- if wyl == blank -%}{%- continue -%}{%- endif -%}
                      {%- assign wyl_label = wyl | split: ':' | first | strip -%}
                      {%- assign wyl_rest = wyl | remove_first: wyl_label | remove_first: ':' | strip -%}
                      {%- if wyl_rest != blank -%}
                        <li><strong>{{ wyl_label }}</strong> {{ wyl_rest }}</li>
                      {%- else -%}
                        <li>{{ wyl }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>

              <!-- Best For -->
              {%- if best_for_details != blank -%}
              <div class="tab-pane" id="bestfor">
                <ul>
                  {%- assign bf_lines = best_for_details | strip | newline_to_br | split: '<br />' -%}
                  {%- for line in bf_lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              </div>
              {%- endif -%}

              <!-- Specifications (two-column grid) -->
              <div class="tab-pane" id="specs">
                {%- comment -%} Collect present specs as "Label|Value" items, then split into two independent columns {%- endcomment -%}
                {%- capture specs_raw -%}
                  {%- if product.vendor != blank -%}Brand|{{ product.vendor }}~|~{%- endif -%}
                  {%- if mf.fragrance_family.value != blank -%}Fragrance Family|{{ mf.fragrance_family.value }}~|~{%- endif -%}
                  {%- if mf.concentration.value != blank -%}Concentration|{{ mf.concentration.value }}~|~{%- endif -%}
                  {%- if mf.size.value != blank -%}Size|{{ mf.size.value }}~|~{%- elsif cv.title != 'Default Title' -%}Size|{{ cv.title }}~|~{%- endif -%}
                  {%- if mf.product_form.value != blank -%}Product Form|{{ mf.product_form.value }}~|~{%- endif -%}
                  {%- if mf.dispenser.value != blank -%}Dispenser|{{ mf.dispenser.value }}~|~{%- endif -%}
                  {%- if mf.gender.value != blank -%}Gender|{{ mf.gender.value }}~|~{%- endif -%}
                  {%- if mf.occasion.value != blank -%}Occasion|{{ mf.occasion.value }}~|~{%- endif -%}
                  {%- if mf.bottle_colour.value != blank -%}Bottle Colour|{{ mf.bottle_colour.value }}~|~{%- endif -%}
                  {%- if mf.longevity.value != blank -%}Longevity|{{ mf.longevity.value }}~|~{%- endif -%}
                  {%- if mf.ships_to.value != blank -%}Ships To|{{ mf.ships_to.value }}~|~{%- endif -%}
                  {%- if mf.barcode.value != blank -%}Barcode|{{ mf.barcode.value }}~|~{%- endif -%}
                {%- endcapture -%}
                {%- assign spec_list = specs_raw | strip | split: '~|~' -%}
                {%- assign spec_half = spec_list.size | plus: 1 | divided_by: 2 -%}
                <div class="spec-cols">
                  {%- for col in (1..2) -%}
                  <div class="spec-col">
                    <div class="spec-item spec-head{% if col == 2 %} spec-head-2{% endif %}"><span class="spec-k">Product Details</span><span class="spec-v">Information</span></div>
                    {%- for item in spec_list -%}
                      {%- assign in_left = false -%}
                      {%- if forloop.index0 < spec_half -%}{%- assign in_left = true -%}{%- endif -%}
                      {%- if col == 1 and in_left -%}
                        {%- assign kv = item | strip | split: '|' -%}
                        <div class="spec-item"><span class="spec-k">{{ kv[0] }}</span><span class="spec-v">{{ kv[1] }}</span></div>
                      {%- elsif col == 2 and in_left == false -%}
                        {%- assign kv = item | strip | split: '|' -%}
                        <div class="spec-item"><span class="spec-k">{{ kv[0] }}</span><span class="spec-v">{{ kv[1] }}</span></div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- endfor -%}
                </div>
              </div>

              <!-- Shipping & Returns -->
              <div class="tab-pane" id="ship">
                <h4>Shipping Information</h4>
                {%- comment -%}
                  Every figure in this paragraph is now a setting — the
                  delivery window, the cutoff hour, the threshold and the
                  rate. It was four numbers typed into a sentence, three of
                  which are also quoted by the arrival date above it, and a
                  shipping paragraph that disagrees with the delivery estimate
                  two inches higher is worse than either alone.
                {%- endcomment -%}
                <p>We deliver across the UAE within {{ settings.delivery_days_min | default: 1 }}–{{ settings.delivery_days_max | default: 4 }} business days. Orders placed after {{ settings.dispatch_cutoff_hour | default: 18 }}:00 (UAE Time) are processed the next business day. Delivery is free on orders of AED {{ settings.free_shipping_threshold | default: '250' }} or more, and AED {{ settings.shipping_flat_rate | default: '8' }} below that. Tracking details are shared once your order has been dispatched.</p>
                <h4>Return Policy</h4>
                <p>Returns are accepted within 2 days only for damaged, defective, incorrect, or incomplete orders. Products must remain unused, sealed, and in their original packaging. Opened perfume bottles and change-of-mind returns cannot be accepted.</p>
              </div>
            </div>
          </div>
        </div><!-- /pdp-info -->
      </div><!-- /pdp-main-inner -->
    </section>

  <!-- FAQ — full width, below the product image and details -->
  {%- if faq != blank -%}
  <section class="section pdp-faq">
    <div class="container" style="max-width:900px">
      <div class="sec-head center">
        <span class="label">Your Questions, Answered</span>
        <h2 class="sec-title">Frequently Asked <em>Questions</em></h2>
      </div>
      <div class="faq-list">
        {%- assign faq_lines = faq | strip | newline_to_br | split: '<br />' -%}
        {%- for line in faq_lines -%}
          {%- assign qa = line | split: ' :: ' -%}
          {%- if qa.size >= 2 -%}
          <details class="faq-item">
            <summary class="faq-q">{{ qa[0] | strip }}<span class="mi" aria-hidden="true">add</span></summary>
            <div class="faq-a">{{ qa[1] | strip }}</div>
          </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- PDP REVIEWS -->
  <section class="pdp-reviews" id="pdp-reviews">
    <div class="pdp-rv-inner">
      <div class="reviews-head fade-up"><span class="label">Verified Reviews</span><h2 class="sec-title">What Customers <em>Say</em></h2></div>
      {%- comment -%}
        Gated on reviews.rating_count alone, which Judge.me owns. custom.review_count
        carries demo values on a handful of products and would claim reviews that
        do not exist.
      {%- endcomment -%}
      {%- assign jm_review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- if jm_review_count == 0 -%}
        <div class="rv-empty">
          <span class="mi" aria-hidden="true">rate_review</span>
          <p><strong>No reviews yet.</strong> Be the first to tell others how {{ product.title }} wears — how it opens, how long it lasts, and when you reach for it.</p>
        </div>
      {%- endif -%}
      <!-- Start of Judge.me code -->
      {% assign has_legacy = false %}{% if product.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}<div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{% endif %}
      <!-- End of Judge.me code -->
    </div>
  </section>

  <!-- MORE FROM THIS BRAND -->
  {%- liquid
    comment
      Prefer the brand's own collection (handle, or handle-perfumes) so the CTA
      lands on a real merchandised page; fall back to the vendor listing.
    endcomment
    assign vendor_handle = product.vendor | handleize
    assign brand_collection = collections[vendor_handle]
    unless brand_collection.handle
      assign vendor_handle_alt = vendor_handle | append: '-perfumes'
      assign brand_collection = collections[vendor_handle_alt]
    endunless

    if brand_collection.handle
      assign brand_url = brand_collection.url
    else
      comment
        /collections/vendors is not a Shopify route — page-brands.liquid says
        so in its own header comment, and it 404s. Search is a real route and
        always resolves, so a vendor with no collection of its own still lands
        the shopper on that brand's products instead of a dead page.
      endcomment
      assign brand_url = '/search?type=product&q=' | append: product.vendor | url_encode
    endif

    assign brand_count = 0
    for p in collections.all.products
      if p.vendor == product.vendor and p.id != product.id
        assign brand_count = brand_count | plus: 1
      endif
    endfor
  -%}
  {%- if brand_count > 0 -%}
  <section class="related">
    <div class="related-inner">
      <div class="related-head fade-up"><span class="label">The House</span><h2 class="sec-title">More from <em>{{ product.vendor }}</em></h2></div>
      <div class="products-grid">
        {%- assign shown = 0 -%}
        {%- for p in collections.all.products -%}
          {%- if p.vendor == product.vendor and p.id != product.id and shown < 4 -%}
            {% render 'product-card', product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="related-cta">
        <a class="btn-o" href="{{ brand_url }}">View all {{ product.vendor }} perfumes <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- RELATED PRODUCTS -->
  <section class="related">
    <div class="related-inner">
      <div class="related-head fade-up"><span class="label">Complete the Set</span><h2 class="sec-title">You May Also <em>Like</em></h2></div>
      {%- assign related = product.metafields.custom.related.value | default: recommendations.products -%}
      {%- if collection.products.size > 1 -%}
        <div class="products-grid">
          {%- for prod in collection.products limit: 4 -%}
            {%- unless prod.id == product.id -%}{% render 'product-card', product: prod %}{%- endunless -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="products-grid" data-render="products" data-count="4"></div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}
    PAIRS WELL WITH — complementary products, fetched by app.js.
    An empty slot until a human has paired something in Search & Discovery;
    the section itself explains why this is curated and not computed.
  {%- endcomment -%}
  <div data-complementary data-product-id="{{ product.id }}"></div>

  {%- comment -%}
    RECENTLY VIEWED — the only strip on this page about the shopper rather
    than the catalogue. Placed after the catalogue-driven rows so it is the
    last thing before the brand and collection exploration, which is where
    someone still deciding between a few bottles will be looking.
  {%- endcomment -%}
  {% render 'recently-viewed' %}

  <!-- EXPLORE OTHER BRANDS -->
  {%- liquid
    assign picked_brands = section.settings.brand_collections
    assign brand_limit = section.settings.brand_limit | default: 4
  -%}
  <section class="section alt brands-strip">
    <div class="container">
      <div class="sec-head center fade-up">
        <span class="label">The Houses</span>
        <h2 class="sec-title">Explore Other <em>Brands</em></h2>
        <p class="sec-sub">From beloved Arabian houses to prestige niche and designer names, every bottle 100% authentic.</p>
      </div>
      <div class="hub-grid four fade-up">
        {%- assign brands_shown = 0 -%}
        {%- if picked_brands.size > 0 -%}
          {%- for brand in picked_brands -%}
            {%- if brands_shown >= brand_limit -%}{%- break -%}{%- endif -%}
            {%- unless brand.handle == brand_collection.handle -%}
              {% render 'collection-card', collection: brand, cta: 'Shop the house' %}
              {%- assign brands_shown = brands_shown | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%}
            Nothing picked in the editor: walk the store's vendors and show the
            ones that have a matching brand collection.
          {%- endcomment -%}
          {%- for vendor_name in collections.all.all_vendors -%}
            {%- if brands_shown >= brand_limit -%}{%- break -%}{%- endif -%}
            {%- if vendor_name == product.vendor -%}{%- continue -%}{%- endif -%}
            {%- assign vendor_slug = vendor_name | handleize -%}
            {%- assign vendor_collection = collections[vendor_slug] -%}
            {%- if vendor_collection.handle == blank -%}
              {%- assign vendor_slug_alt = vendor_name | replace: '&', 'and' | handleize -%}
              {%- assign vendor_collection = collections[vendor_slug_alt] -%}
            {%- endif -%}
            {%- if vendor_collection.handle == blank or vendor_collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
            {%- if vendor_collection.handle == brand_collection.handle -%}{%- continue -%}{%- endif -%}
            {% render 'collection-card', collection: vendor_collection, cta: 'Shop the house' %}
            {%- assign brands_shown = brands_shown | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="related-cta">
        <a class="btn-o" href="/pages/brands">View all brands <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
    </div>
  </section>

  <!-- BEST SELLERS -->
  {%- if collections['best-sellers'].products.size > 0 -%}
  <section class="related">
    <div class="related-inner">
      <div class="related-head fade-up"><span class="label">Loved by Many</span><h2 class="sec-title">Our <em>Best Sellers</em></h2></div>
      <div class="products-grid">
        {%- assign shown = 0 -%}
        {%- for p in collections['best-sellers'].products -%}
          {%- if p.id != product.id and shown < 4 -%}{% render 'product-card', product: p %}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="related-cta">
        <a class="btn-o" href="{{ collections['best-sellers'].url }}">Shop all best sellers <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- EXPLORE MORE COLLECTIONS -->
  {%- comment -%}
    Brand is covered by the Explore Other Brands strip above, so these four
    tiles cover the remaining hubs.
  {%- endcomment -%}
  <section class="section"><div class="container">
    <div class="sec-head center fade-up">
      <span class="label">Keep Looking</span>
      <h2 class="sec-title">Explore More <em>Collections</em></h2>
      <p class="sec-sub">Continue exploring fragrances based on category, lifestyle, climate and scent family to discover your next signature fragrance.</p>
    </div>
    <div class="explore-grid">
      <a class="explore-card fade-up" href="/pages/shop-by-category">
        <span class="mi ex-ic" aria-hidden="true">grid_view</span>
        <b>Shop by Category</b>
        <span class="ex-sub">Every way to shop, in one place</span>
        <span class="ex-go">Browse <span class="mi" aria-hidden="true">arrow_forward</span></span>
      </a>
      <a class="explore-card fade-up" href="/pages/shop-by-lifestyle">
        <span class="mi ex-ic" aria-hidden="true">auto_awesome</span>
        <b>Shop by Lifestyle</b>
        <span class="ex-sub">Office, date night, everyday</span>
        <span class="ex-go">Browse <span class="mi" aria-hidden="true">arrow_forward</span></span>
      </a>
      <a class="explore-card fade-up" href="/pages/shop-by-climate">
        <span class="mi ex-ic" aria-hidden="true">wb_sunny</span>
        <b>Shop by Climate</b>
        <span class="ex-sub">Summer, humid, cooler days</span>
        <span class="ex-go">Browse <span class="mi" aria-hidden="true">arrow_forward</span></span>
      </a>
      <a class="explore-card fade-up" href="/collections/oud-woody-perfumes">
        <span class="mi ex-ic" aria-hidden="true">spa</span>
        <b>Shop by Scent Family</b>
        <span class="ex-sub">Fresh, oud, spicy, sweet</span>
        <span class="ex-go">Browse <span class="mi" aria-hidden="true">arrow_forward</span></span>
      </a>
    </div>
      <div class="sibling-all">
      <a class="btn-ghost" href="/pages/shop-by-category">See All Categories <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
  </div></section>

  <!-- WHY CUSTOMERS CHOOSE THE FRAGRANCE SECRETS -->
  <section class="section why-choose">
    <div class="container">
      <div class="sec-head center">
        <span class="label">Why Shop With Us</span>
        <h2 class="sec-title">Why Customers Choose <em>The Fragrance Secrets</em></h2>
      </div>
      <div class="why-grid six">
        <div class="why-card fade-up"><span class="mi" aria-hidden="true">verified</span><h3>100% Authentic Perfumes</h3></div>
        <div class="why-card fade-up"><span class="mi" aria-hidden="true">local_shipping</span><h3>Fast UAE Delivery</h3></div>
        <div class="why-card fade-up"><span class="mi" aria-hidden="true">lock</span><h3>Secure Payments</h3></div>
        <div class="why-card fade-up"><span class="mi" aria-hidden="true">diamond</span><h3>Premium Fragrance Collection</h3></div>
        <div class="why-card fade-up"><span class="mi" aria-hidden="true">inventory_2</span><h3>Carefully Packed Orders</h3></div>
        <div class="why-card fade-up"><span class="mi" aria-hidden="true">redeem</span><h3>Perfect for Gifting</h3></div>
      </div>
    </div>
  </section>

  {%- comment -%} Product + FAQPage + BreadcrumbList structured data {%- endcomment -%}
  {% render 'product-schema', product: product %}

  <!-- STICKY ATC BAR -->
  <div class="sticky-atc" id="stickyatc">
    <div class="sticky-atc-inner">
      <span class="prod-name-mini">{{ product.title }}</span>
      <span class="price-mini">{{ cv.price | money_with_currency }}</span>
      <button type="button" class="atc-mini" onclick="document.getElementById('product-form').requestSubmit()">Add to Cart</button>
    </div>
  </div>
</main-product>

<script>
(function () {
  var wrap = document.querySelector('.main-img-wrap');
  if (!wrap) return;
  var img = wrap.querySelector('.main-img');
  if (!img) return;
  /* No hover on touch — binding here would leave the image stuck zoomed. */
  if (!(window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches)) return;

  /* The gallery serves a 900px image, which is soft once magnified. Rewriting
     the width parameter gives a sharp source without paying for it on load, and
     because it reads the CURRENT src it keeps working after a thumbnail swap. */
  function hiRes(src) { return src.replace(/([?&])width=\d+/, '$1width=1800'); }
  function upgrade() {
    var target = hiRes(img.currentSrc || img.src);
    if (!target || target === (img.currentSrc || img.src)) return;
    var pre = new Image();
    pre.onload = function () { img.src = target; };
    pre.src = target;
  }

  function track(e) {
    var r = wrap.getBoundingClientRect();
    if (!r.width || !r.height) return;
    var x = Math.max(0, Math.min(100, ((e.clientX - r.left) / r.width) * 100));
    var y = Math.max(0, Math.min(100, ((e.clientY - r.top) / r.height) * 100));
    img.style.setProperty('--zx', x + '%');
    img.style.setProperty('--zy', y + '%');
  }

  wrap.addEventListener('mouseenter', function (e) { track(e); upgrade(); wrap.classList.add('is-zoom'); });
  wrap.addEventListener('mousemove', track);
  wrap.addEventListener('mouseleave', function () { wrap.classList.remove('is-zoom'); });
})();
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "header", "content": "Explore other brands" },
    { "type": "collection_list", "id": "brand_collections", "label": "Brands to feature", "limit": 12, "info": "Leave empty to fall back to brand collections found automatically. The current product's own brand is always skipped." },
    { "type": "range", "id": "brand_limit", "label": "Brand cards to show", "min": 3, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Product page" } ]
}
{% endschema %}
